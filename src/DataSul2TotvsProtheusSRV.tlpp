#include "totvs.ch"

#include "tlpp-core.th"

namespace dna.tech.DataSul2Protheus

using namespace dna.tech
using namespace dna.tech.DataSul2Protheus

#include "execin.th"
EXECIN CLASS SRVImport

static function SRVGetValue(xGet as variant,xDefault as variant) as variant
return(cacheData():Get("datasul2totvsprotheus",xGet,xDefault))

static function SRVSetValue(xVar as variant,xValue as variant) as variant
return(cacheData():Set("datasul2totvsprotheus",xVar,xValue))

static function SRVDeleteIfEmpty(cAlias,lMemory) as logical
    local lSRVDeleteIfEmpty:=.F. as logical
    begin sequence
        if (lMemory)
            lSRVDeleteIfEmpty:=Empty(SRVGetValue("RV_COD"))
            if (lSRVDeleteIfEmpty)
                break
            endif
        else
            lSRVDeleteIfEmpty:=(cAlias)->(Empty(RV_COD))
        endif
    end sequence
return(lSRVDeleteIfEmpty)

static function SRVImportData(oMsNewProcess as object,lEnd as logical,lPercentage as logical) as logical

    local aAddIndex as array

    local cAlias:="SRV" as character
    local cIndexKey as character
    local cTableImport:="SRV" as character

    local cAliasTMP:=getNextAlias() as character

    local lSRVImport as logical

    local oTFIni:=cacheData():Get("datasul2totvsprotheus","ReadIniFile") as object
    local oTLogReport:=tLogReport():New() as object

    begin sequence

        beginSQL alias cAliasTMP
            %noParser%
            SELECT DISTINCT 1 RVCODFOL
              FROM %table:SRV% SRV
             WHERE SRV.%NotDel%
               AND SRV.RV_CODFOL<>''
        endSQL

        lSRVImport:=((cAliasTMP)->RVCODFOL!=1)

        (cAliasTMP)->(dbCloseArea())

        if (!lSRVImport)
            ApMsgInfo("Problems were encountered while processing the "+cTableImport+" table. Already Exists RV_CODFOL","Info")
            break
        endif

        cIndexKey:=allTrim(oTFIni:GetPropertyValue(cTableImport,"IndexKey","RV_FILIAL+RV_COD"))
        aAddIndex:=StrTokArr2(allTrim(oTFIni:GetPropertyValue(cTableImport,"AddIndex","RV_FILIAL,RV_COD")),",",.T.)

        lSRVImport:=dna.tech.DataSul2Protheus.datasul2totvs():Execute("dna.tech.DataSul2Protheus.ImportData",@oMsNewProcess,@lEnd,lPercentage,@oTLogReport,@cAlias,@cIndexKey,@cTableImport,@aAddIndex)

        if (lSRVImport)
            ApMsgInfo(cAlias+" Table Import Completed","Info")
        else
            ApMsgInfo("Problems were encountered while processing the "+cTableImport+" table","Info")
        endif

    end sequence

    oTLogReport:PrintDialog("Log de Ocorrencias na Importacao: ["+cAlias+"]"+Upper(FWSX2Util():GetX2Name(cAlias,.F.)))
    MsAguarde({||oTLogReport:FreeObj()},"Releasing temporary files and workspace memory...","Wait...")
    FreeObj(@oTLogReport)

    FWFreeArray(@aAddIndex)

    DelClassIntF()

return(lSRVImport)

static function RCNImportData(cAlias,oTLogReport,oMsNewProcess,oTimeRemaining,oProgress)

    local aLine as array
    local aTPPD as array

    local cPD as character
    local cLine as character
    local cIncProc as character
    local cIndexID as character
    local cLineRead as character
    local cRecCount as character
    local cDataPath:=dna.tech.DataSul2Protheus.datasul2totvs():Execute("dna.tech.DataSul2Protheus.GetDataPath") as character
    local cDataFile:="totvs_rcn_2_srv.csv" as character
    local cSRVFilial:=xFilial("SRV") as character
    local cTimeRemaining as character

    local lFound as logical
    local lAddNew as logical

    local nLine as numeric
    local nTPPD as numeric
    local nRecProc as numeric
    local nRecCount as numeric

    local nFTfHandle as numeric

    local nSRVDesc as numeric
    local nSRVDescDec as numeric

    local oFileReader as object

    if (Right(cDataPath,1)!="\")
        cDataPath+="\"
    endif

    if (Select("SRVCODFOL")==0)
        dBChangeAlias("SRV","SRVCODFOL")
        ChkFile("SRV")
    endif
    SRV->(dbSetOrder(RetOrder("SRV","RV_FILIAL+RV_COD")))
    SRVCODFOL->(dbSetOrder(RetOrder("SRV","RV_FILIAL+RV_CODFOL")))

    if (File(cDataPath+cDataFile))
        oFileReader:=fileTools():FileReader("FILE")
        nFTfHandle:=oFileReader:ft_fUse(cDataPath+cDataFile)
        if (nFTfHandle>=0)
            nRecCount:=(oFileReader:ft_fLastRec()-1)
            cRecCount:=cTools():NToS(nRecCount)
            oMsNewProcess:SetRegua1(nRecCount)
            oTimeRemaining:SetRemaining(nRecCount)
            nSRVDesc:=GetSX3Cache("RV_DESC","X3_TAMANHO")
            nSRVDescDec:=GetSX3Cache("RV_DESCDET","X3_TAMANHO")
            aTPPD:=Array(3)
            while (!oFileReader:ft_fEof())
                oFileReader:ft_fSkip()
                while (!oFileReader:ft_fEof())
                    nRecProc:=oFileReader:ft_fRecNo()
                    cLineRead:=oFileReader:ft_fReadLN()
                    cLine:=DecodeUTF8(cLineRead)
                    if (Empty(cLine))
                        cLine:=cLineRead
                    endif
                    aLine:=StrTokArr2(cLine,";",.T.)
                    if (Len(aLine)<4)
                        FWFreeArray(@aLine)
                        oFileReader:ft_fSkip()
                        loop
                    endif
                    nTPPD:=Val(Left(aLine[4],1))
                    if (aTPPD[nTPPD]==nil)
                        aTPPD[nTPPD]:=Array(0)
                    endif
                    aAdd(aTPPD[nTPPD],aClone(aLine))
                    *********************************************************************************************
                    oTimeRemaining:Calcule(.F.)
                    cTimeRemaining:=" :: End of processing in ["+oTimeRemaining:GetcTRemaining()+"]["+DtoC(oTimeRemaining:GetdEndTime())+"]"
                    cTimeRemaining+="["+oTimeRemaining:GetcEndTime()+"]"
                    cTimeRemaining+="[+/-]"
                    cTimeRemaining+="["+oTimeRemaining:GetcAverageTime()+"]"
                    cIncProc:="["+oProgress:Eval()+"] "
                    cIncProc+="Record ["
                    cIncProc+=cTools():NToS(nRecProc)
                    cIncProc+="/"
                    cIncProc+=cRecCount
                    cIncProc+="] :: "
                    cIncProc+="ID ["+aLine[1]+"]"
                    cIncProc+=cTimeRemaining
                    cIncProc+=" :: ["+cTools():NToS(Round(((nRecProc/nRecCount)*100),2))+"%]"
                    oMsNewProcess:IncRegua2(cIncProc)
                    *********************************************************************************************
                    FWFreeArray(@aLine)
                    oFileReader:ft_fSkip()
                end while
            end while
            oFileReader:ft_fUse()
            oFileReader:FreeObj()
            FreeObj(@oFileReader)
            *********************************************************************************************
            nRecProc:=0
            oMsNewProcess:SetRegua1(nRecCount)
            oTimeRemaining:SetRemaining(nRecCount)
            for nTPPD:=1 to Len(aTPPD)
                cPD:=(tlpp.ToStr(nTPPD)+"A0")
                for nLine:=1 to Len(aTPPD[nTPPD])
                    aLine:=aTPPD[nTPPD][nLine]
                    aLine[4]:=cPD
                    cIndexID:=cSRVFilial
                    cIndexID+=aLine[4]
                    if (SRVCODFOL->(!dbSeek(cSRVFilial+aLine[1])))
                        lFound:=SRV->(dbSeek(cIndexID,.F.))
                        lAddNew:=(!lFound)
                        if (SRV->(RecLock("SRV",lAddNew)))
                            SRV->RV_FILIAL:=cSRVFilial
                            SRV->RV_COD:=aLine[4]
                            SRV->RV_TIPO:=aLine[3]
                            SRV->RV_CODFOL:=aLine[1]
                            SRV->RV_DESC:=dna.tech.cTools():TruncateName(aLine[2],nSRVDesc,.T.,.T.)
                            SRV->RV_DESCDET:=dna.tech.cTools():TruncateName(aLine[2],nSRVDescDec,.T.,.T.)
                            SRV->(MsUnLock())
                        endif
                    endif
                    *********************************************************************************************
                    oTimeRemaining:Calcule(.F.)
                    cTimeRemaining:=" :: End of processing in ["+oTimeRemaining:GetcTRemaining()+"]["+DtoC(oTimeRemaining:GetdEndTime())+"]"
                    cTimeRemaining+="["+oTimeRemaining:GetcEndTime()+"]"
                    cTimeRemaining+="[+/-]"
                    cTimeRemaining+="["+oTimeRemaining:GetcAverageTime()+"]"
                    cIncProc:="["+oProgress:Eval()+"] "
                    cIncProc+="Record ["
                    cIncProc+=cTools():NToS(++nRecProc)
                    cIncProc+="/"
                    cIncProc+=cRecCount
                    cIncProc+="] :: "
                    cIncProc+="ID ["+aLine[1]+"]"
                    cIncProc+=cTimeRemaining
                    cIncProc+=" :: ["+cTools():NToS(Round(((nRecProc/nRecCount)*100),2))+"%]"
                    oMsNewProcess:IncRegua2(cIncProc)
                    *********************************************************************************************
                    FWFreeArray(@aLine)
                    *********************************************************************************************
                    cPD:=__Soma1(cPD)
                next nLine
            next nTPPD
            FWFreeArray(@aTPPD)
        endif
    endif

return(.T.)
