    ,"FILEREADER_TOPCONN"               :  {"Owner":"DNATech","Reader":"","RDD":"TOPCONN"   ,"Call":3,"Token":"","TimeProcStart":"","TimeProcEnd":"","PartialTimeProc":0,"TotalTimeProc":0,"PartialTimeReader":0,"TotalTimeReader":0,"Lines":0,"MinLineSize":0,"MaxLineSize":0,"TotalLinesRead":0,"FileSize":0,"PartialBytesRead":0,"TotalBytesRead":0,"PartialTimeStrTokArr":0,"PartialTimeStrTokArr2":0,"PartialTime__StrTokArray":0,"TotalTimeStrTokArr":0,"TotalTimeStrTokArr2":0,"TotalTime__StrTokArray":0,"StrHashExpected":0,"StrHash":0,"StrTokArrHashExpected":0,"StrTokArrHash":0,"StrTokArr2Hash":0,"__StrTokArrayHash":0,"PartialTimeStrHash":0,"TotalTimeStrHash":0,"TimeOutThresHold":0,"IsDisqualifiedByTimeOut":false,"PartialTimeIsDisqualifiedVerify":0,"TotalTimeIsDisqualifiedVerify":0,"ProcStart":0,"ProcEnd":0,"PartialStrTokArr":0,"PartialStrTokArr2":0,"Partial__StrTokArray":0,"TotalStrTokArr":0,"TotalStrTokArr2":0,"Total__StrTokArray":0,"StrHashLog":false,"PartialTimeRandom":0,"TotalTimeRandom":0,"PartialTimeLineSize":0,"TotalTimeLineSize":0}
    ,"FILEREADER_TOPCONN_TOKARRAYDB"    :  {"Owner":"DNATech","Reader":"","RDD":"TOPCONN"   ,"Call":3,"Token":"","TimeProcStart":"","TimeProcEnd":"","PartialTimeProc":0,"TotalTimeProc":0,"PartialTimeReader":0,"TotalTimeReader":0,"Lines":0,"MinLineSize":0,"MaxLineSize":0,"TotalLinesRead":0,"FileSize":0,"PartialBytesRead":0,"TotalBytesRead":0,"PartialTimeStrTokArr":0,"PartialTimeStrTokArr2":0,"PartialTime__StrTokArray":0,"TotalTimeStrTokArr":0,"TotalTimeStrTokArr2":0,"TotalTime__StrTokArray":0,"StrHashExpected":0,"StrHash":0,"StrTokArrHashExpected":0,"StrTokArrHash":0,"StrTokArr2Hash":0,"__StrTokArrayHash":0,"PartialTimeStrHash":0,"TotalTimeStrHash":0,"TimeOutThresHold":0,"IsDisqualifiedByTimeOut":false,"PartialTimeIsDisqualifiedVerify":0,"TotalTimeIsDisqualifiedVerify":0,"ProcStart":0,"ProcEnd":0,"PartialStrTokArr":0,"PartialStrTokArr2":0,"Partial__StrTokArray":0,"TotalStrTokArr":0,"TotalStrTokArr2":0,"Total__StrTokArray":0,"StrHashLog":false,"PartialTimeRandom":0,"TotalTimeRandom":0,"PartialTimeLineSize":0,"TotalTimeLineSize":0}
    ,"FWFILEREADER"                     :  {"Owner":"TOTVS  ","Reader":"","RDD":""          ,"Call":3,"Token":"","TimeProcStart":"","TimeProcEnd":"","PartialTimeProc":0,"TotalTimeProc":0,"PartialTimeReader":0,"TotalTimeReader":0,"Lines":0,"MinLineSize":0,"MaxLineSize":0,"TotalLinesRead":0,"FileSize":0,"PartialBytesRead":0,"TotalBytesRead":0,"PartialTimeStrTokArr":0,"PartialTimeStrTokArr2":0,"PartialTime__StrTokArray":0,"TotalTimeStrTokArr":0,"TotalTimeStrTokArr2":0,"TotalTime__StrTokArray":0,"StrHashExpected":0,"StrHash":0,"StrTokArrHashExpected":0,"StrTokArrHash":0,"StrTokArr2Hash":0,"__StrTokArrayHash":0,"PartialTimeStrHash":0,"TotalTimeStrHash":0,"TimeOutThresHold":0,"IsDisqualifiedByTimeOut":false,"PartialTimeIsDisqualifiedVerify":0,"TotalTimeIsDisqualifiedVerify":0,"ProcStart":0,"ProcEnd":0,"PartialStrTokArr":0,"PartialStrTokArr2":0,"Partial__StrTokArray":0,"TotalStrTokArr":0,"TotalStrTokArr2":0,"Total__StrTokArray":0,"StrHashLog":false,"PartialTimeRandom":0,"TotalTimeRandom":0,"PartialTimeLineSize":0,"TotalTimeLineSize":0}
    ,"FT"                               :  {"Owner":"TOTVS  ","Reader":"","RDD":""          ,"Call":3,"Token":"","TimeProcStart":"","TimeProcEnd":"","PartialTimeProc":0,"TotalTimeProc":0,"PartialTimeReader":0,"TotalTimeReader":0,"Lines":0,"MinLineSize":0,"MaxLineSize":0,"TotalLinesRead":0,"FileSize":0,"PartialBytesRead":0,"TotalBytesRead":0,"PartialTimeStrTokArr":0,"PartialTimeStrTokArr2":0,"PartialTime__StrTokArray":0,"TotalTimeStrTokArr":0,"TotalTimeStrTokArr2":0,"TotalTime__StrTokArray":0,"StrHashExpected":0,"StrHash":0,"StrTokArrHashExpected":0,"StrTokArrHash":0,"StrTokArr2Hash":0,"__StrTokArrayHash":0,"PartialTimeStrHash":0,"TotalTimeStrHash":0,"TimeOutThresHold":0,"IsDisqualifiedByTimeOut":false,"PartialTimeIsDisqualifiedVerify":0,"TotalTimeIsDisqualifiedVerify":0,"ProcStart":0,"ProcEnd":0,"PartialStrTokArr":0,"PartialStrTokArr2":0,"Partial__StrTokArray":0,"TotalStrTokArr":0,"TotalStrTokArr2":0,"Total__StrTokArray":0,"StrHashLog":false,"PartialTimeRandom":0,"TotalTimeRandom":0,"PartialTimeLineSize":0,"TotalTimeLineSize":0}
}
    endContent

    jPerform:=JSONObject():New()
    jPerform:FromJSON(cPerform)
    aPerform:=jPerform:GetNames()

    for nFile:=1 to Len(jFiles)
        if (!jFiles[nFile]["Process"])
            loop
        endif
        cLine:=""
        cFile:=jFiles[nFile]["File"]
        lDecodeUTF8:=jFiles[nFile]["DecodeUTF8"]
        for i:=1 to 2
            lExecuteProc:=NTools():ContainN(jFiles[nFile]["Call"],i)
            if (!lExecuteProc)
                loop
            endif
            lSequential:=(i==1)
            oFileLogger:WriteLine("FileName["+cFile+"] "+if(!lSequential,"Not ","")+"Sequential reading")
            for j:=1 to Len(aPerform)
                cFileReader:=aPerform[j]
                //Call: 0-Not Call;1=Sequential;2=Not Sequential;3=Both
                lExecuteProc:=NTools():ContainN(jFiles[nFile]["Call"],jPerform[cFileReader]["Call"])
                if (!lExecuteProc)
                    loop
                endif
                if (cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB")
                    if ("MSSQL"!=cTCGETDB)
                        loop
                    else
                        if (!jPerform[cFileReader]:HasProperty("TotalStrTokArrayInDB"))
                            jPerform[cFileReader]["TotalStrTokArrayInDB"]:=0
                            jPerform[cFileReader]["TotalTimeStrTokArrayInDB"]:=0
                        endif
                        jPerform[cFileReader]["PartialStrTokArrayInDB"]:=0
                        jPerform[cFileReader]["PartialTimeStrTokArrayInDB"]:=0
                    endif
                endif
                jPerform[cFileReader]["Reader"]:=cFileReader
                jPerform[cFileReader]["Token"]:=jFiles[nFile]["Token"]
                jPerform[cFileReader]["Lines"]:=0
                jPerform[cFileReader]["FileSize"]:=0
                jPerform[cFileReader]["PartialBytesRead"]:=0
                jPerform[cFileReader]["MinLineSize"]:=0
                jPerform[cFileReader]["MaxLineSize"]:=0
                jPerform[cFileReader]["PartialStrTokArr"]:=0
                jPerform[cFileReader]["PartialTimeStrTokArr"]:=0
                jPerform[cFileReader]["PartialStrTokArr2"]:=0
                jPerform[cFileReader]["PartialTimeStrTokArr2"]:=0
                jPerform[cFileReader]["Partial__StrTokArray"]:=0
                jPerform[cFileReader]["PartialTime__StrTokArray"]:=0
                jPerform[cFileReader]["StrHash"]:=0
                jPerform[cFileReader]["StrTokArrHash"]:=0
                jPerform[cFileReader]["StrTokArr2Hash"]:=0
                jPerform[cFileReader]["__StrTokArrayHash"]:=0
                jPerform[cFileReader]["StrHashExpected"]:=jFiles[nFile]["StrHashExpected"]
                jPerform[cFileReader]["StrTokArrHashExpected"]:=jFiles[nFile]["StrTokArrHashExpected"]
                jPerform[cFileReader]["PartialTimeStrHash"]:=0
                jPerform[cFileReader]["IsDisqualifiedByTimeOut"]:=.F.
                jPerform[cFileReader]["PartialTimeIsDisqualifiedVerify"]:=0
                jPerform[cFileReader]["PartialTimeRandom"]:=0
                jPerform[cFileReader]["PartialTimeLineSize"]:=0
                if ((lStrHashLog).and.(jFiles[nFile]["StrHashLog"]))
                    jPerform[cFileReader]["StrHashLog"]:=.T.
                    jPerform[cFileReader]["StrHashLoggerFile"]:=__HashLoggerFile(cFile+"."+cFileReader+"."+UUIDRandomSeq()+".log")
                    jPerform[cFileReader]["StrHashLogger"]:=FileLogger():New(jPerform[cFileReader]["StrHashLoggerFile"])
                endif
                jPerform[cFileReader]["TimeOutThresHold"]:=(jFiles[nFile]["TimeOutThresHold"]*if(jPerform[cFileReader]["StrHashLog"],4,2))
                if (cFileReader=="FT")
                    jPerform[cFileReader]["HasBreakLine"]:=jFiles[nFile]["HasBreakLine"]
                    __TST_FT(oFileLogger,cFile,jPerform[cFileReader],lSequential,lDecodeUTF8)
                elseif (cFileReader=="FWFILEREADER")
                    __TST_FWFILEREADER(oFileLogger,cFile,jPerform[cFileReader],lSequential,lDecodeUTF8)
                elseif (cFileReader=="TFILEREAD")
                    __TST_TFILEREAD(oFileLogger,cFile,jPerform[cFileReader],lSequential,lDecodeUTF8)
                elseif (cFileReader=="FILENAVIGATOR")
                    __TST_FILENAVIGATOR(oFileLogger,cFile,jPerform[cFileReader],lSequential,lDecodeUTF8)
                elseif (cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB")
                    __TST_FILEREADER_StrTokArrayInDB(oFileLogger,cFile,jPerform[cFileReader],lSequential,lDecodeUTF8)
                else
                    __TST_FILEREADER(oFileLogger,cFile,jPerform[cFileReader],lSequential,lDecodeUTF8)
                endif
            next j
        next i
        oFileLogger:WriteLine("")
    next nFile

    for k:=1 to Len(aPerform)
        cFileReader:=aPerform[k]
        if (jPerform[cFileReader]["TotalTimeReader"]==0)
            loop
        endif
        oFileLogger:WriteLine(cFileReader+" => ElapTimeReaderTotal["+__MiliSecondsToTime(jPerform[cFileReader]["TotalTimeReader"])+"]")
    next i

    oFileLogger:Close()
    FreeObj(@oFileLogger)

    if (DirTools():MakeFileDir("c:"+cFileLogger))
        __CopyFile(cFileLogger,"c:"+cFileLogger)
        fErase(cFileLogger)
    endif

    FWFreeArray(@jFiles)

    FWFreeArray(@aPerform)

    FreeObj(@jPerform)

return

static function __HashLoggerFile(cFile as character)
    local cSPPDrive as character
    local cSPPPath as character
    local cSPPFile as character
    local cSPPExt as character
    SplitPath(cFile,@cSPPDrive,@cSPPPath,@cSPPFile,@cSPPExt)
    cFile:="\tmp\"
    cFile+=cSPPFile
    cFile+=cSPPExt
    DirTools():MakeFileDir(cFile)
return(cFile)

static procedure __TSTStrTokArray(cLine as character,jPerformReader as json,lDecodeUTF8 as logical)

    local cToken:=jPerformReader["Token"] as character
    local cLineStrHash as character

    local aLine as array

    local nStrTokTime as numeric

    *****************************************************************
    nStrTokTime:=TimeCounter()
        aLine:=StrTokArr(cLine,cToken)
        cLineStrHash:=""
        aEval(aLine,{|e|cLineStrHash+=(e+cToken)})
        cLineStrHash:=StrTran(cLineStrHash,cLine,"")
        if (cLineStrHash==cToken)
            cLineStrHash:=""
        endif
        jPerformReader["PartialStrTokArr"]+=Len(aLine)
        FWFreeArray(@aLine)
    jPerformReader["PartialTimeStrTokArr"]+=(TimeCounter()-nStrTokTime)
    *****************************************************************
    if (Len(cLineStrHash)>0)
        __StrHashTokArr(cLineStrHash,jPerformReader,"StrTokArr")
    endif
    *****************************************************************
    nStrTokTime:=TimeCounter()
        aLine:=StrTokArr2(cLine,cToken,.T.)
        cLineStrHash:=""
        aEval(aLine,{|e|cLineStrHash+=(e+cToken)})
        cLineStrHash:=StrTran(cLineStrHash,cLine,"")
        if (cLineStrHash==cToken)
            cLineStrHash:=""
        endif
        jPerformReader["PartialStrTokArr2"]+=Len(aLine)
        FWFreeArray(@aLine)
    jPerformReader["PartialTimeStrTokArr2"]+=(TimeCounter()-nStrTokTime)
    *****************************************************************
    if (Len(cLineStrHash)>0)
        __StrHashTokArr(cLineStrHash,jPerformReader,"StrTokArr2")
    endif
    *****************************************************************
    nStrTokTime:=TimeCounter()
        aLine:=cTools():__StrTokArray(cLine,cToken)
        cLineStrHash:=""
        aEval(aLine,{|e|cLineStrHash+=(e+cToken)})
        cLineStrHash:=StrTran(cLineStrHash,cLine,"")
        if (cLineStrHash==cToken)
            cLineStrHash:=""
        endif
        jPerformReader["Partial__StrTokArray"]+=Len(aLine)
        FWFreeArray(@aLine)
    jPerformReader["PartialTime__StrTokArray"]+=(TimeCounter()-nStrTokTime)
    *****************************************************************
    if (Len(cLineStrHash)>0)
        __StrHashTokArr(cLineStrHash,jPerformReader,"__StrTokArray")
    endif
    *****************************************************************

return

static procedure __StrHash(cStr as character,jPerformReader as json)
    local lStrHashLog:=jPerformReader["StrHashLog"] as logical
    local nStrHash as numeric
    local nPartialTimeStrHash:=TimeCounter() as numeric
    nStrHash:=cTools():StrHash(cStr)
    jPerformReader["StrHash"]+=nStrHash
    if (lStrHashLog)
        jPerformReader["StrHashLogger"]:WriteLine(StrZero(nStrHash,16)+" "+cStr)
    endif
    jPerformReader["PartialTimeStrHash"]+=(TimeCounter()-nPartialTimeStrHash)
return

static procedure __StrHashTokArr(cStr as character,jPerformReader as json,cTokArr as character)
    local nStrHash as numeric
    local nPartialTimeStrHash:=TimeCounter() as numeric
    nStrHash:=cTools():StrHash(cStr)
    jPerformReader[cTokArr+"Hash"]+=nStrHash
    jPerformReader["PartialTimeStrHash"]+=(TimeCounter()-nPartialTimeStrHash)
return

static procedure __SendToLogger(oFileLogger as object,jPerformReader as json)

    local cFileReader as character
    local jPerformReaderOut as json

    local lStrHashLog as logical

    cFileReader:=jPerformReader["Reader"]

    jPerformReader["PartialTimeProc"]:=(jPerformReader["ProcEnd"]-jPerformReader["ProcStart"])
    jPerformReader["PartialTimeReader"]:=(;
        jPerformReader["PartialTimeProc"]-(;
            jPerformReader["PartialTimeStrTokArr"];
           +jPerformReader["PartialTimeStrTokArr2"];
           +jPerformReader["PartialTime__StrTokArray"];
           +jPerformReader["PartialTimeStrHash"];
           +jPerformReader["PartialTimeIsDisqualifiedVerify"];
           +jPerformReader["PartialTimeRandom"];
           +jPerformReader["PartialTimeLineSize"];
           +if(cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB",jPerformReader["PartialTimeStrTokArrayInDB"],0);
        );
    )

    jPerformReader["TotalTimeProc"]+=jPerformReader["PartialTimeProc"]
    jPerformReader["TotalTimeReader"]+=jPerformReader["PartialTimeReader"]
    jPerformReader["TotalTimeStrTokArr"]+=jPerformReader["PartialTimeStrTokArr"]
    jPerformReader["TotalTimeStrTokArr2"]+=jPerformReader["PartialTimeStrTokArr2"]
    jPerformReader["TotalTime__StrTokArray"]+=jPerformReader["PartialTime__StrTokArray"]

    jPerformReader["TotalStrTokArr"]+=jPerformReader["PartialStrTokArr"]
    jPerformReader["TotalStrTokArr2"]+=jPerformReader["PartialStrTokArr2"]
    jPerformReader["Total__StrTokArray"]+=jPerformReader["Partial__StrTokArray"]

    jPerformReader["TotalLinesRead"]+=jPerformReader["Lines"]
    jPerformReader["TotalBytesRead"]+=jPerformReader["PartialBytesRead"]

    jPerformReader["TotalTimeStrHash"]+=jPerformReader["PartialTimeStrHash"]

    jPerformReader["TotalTimeIsDisqualifiedVerify"]+=jPerformReader["PartialTimeIsDisqualifiedVerify"]

    jPerformReader["TotalTimeRandom"]+=jPerformReader["PartialTimeRandom"]

    jPerformReader["TotalTimeLineSize"]+=jPerformReader["PartialTimeLineSize"]

    if (cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB")
        jPerform[cFileReader]["TotalStrTokArrayInDB"]+=jPerform[cFileReader]["PartialStrTokArrayInDB"]
        jPerform[cFileReader]["TotalTimeStrTokArrayInDB"]+=jPerform[cFileReader]["PartialTimeStrTokArrayInDB"]
    endif

    lStrHashLog:=jPerformReader["StrHashLog"]
    if (lStrHashLog)
        jPerformReader["StrHashLogger"]:Close()
        FreeObj(@jPerformReader["StrHashLogger"])
        DirTools():MakeFileDir("c:\"+jPerformReader["StrHashLoggerFile"])
        if (__CopyFile(jPerformReader["StrHashLoggerFile"],"c:\"+jPerformReader["StrHashLoggerFile"]))
            fErase(jPerformReader["StrHashLoggerFile"])
        endif
        jPerformReader:DelName("StrHashLogger")
        jPerformReader:DelName("StrHashLoggerFile")
    endif
    jPerformReader:DelName("StrHashLog")

    jPerformReaderOut:=JSONObjectClone():CloneJSON(jPerformReader)

    jPerformReaderOut["Reader"]:=PadR(jPerformReaderOut["Reader"],29)
    jPerformReaderOut["Owner"]:=PadR(jPerformReaderOut["Owner"],7)
    jPerformReaderOut["RDD"]:=PadR(jPerformReaderOut["RDD"],10)

    jPerformReaderOut["TotalTimeProc"]:=__MiliSecondsToTime(jPerformReaderOut["TotalTimeProc"])
    jPerformReaderOut["PartialTimeProc"]:=__MiliSecondsToTime(jPerformReaderOut["PartialTimeProc"])

    jPerformReaderOut["TotalTimeReader"]:=__MiliSecondsToTime(jPerformReaderOut["TotalTimeReader"])
    jPerformReaderOut["PartialTimeReader"]:=__MiliSecondsToTime(jPerformReaderOut["PartialTimeReader"])

    jPerformReaderOut["TotalTimeStrTokArr"]:=__MiliSecondsToTime(jPerformReaderOut["TotalTimeStrTokArr"])
    jPerformReaderOut["PartialTimeStrTokArr"]:=__MiliSecondsToTime(jPerformReaderOut["PartialTimeStrTokArr"])

    jPerformReaderOut["TotalTimeStrTokArr2"]:=__MiliSecondsToTime(jPerformReaderOut["TotalTimeStrTokArr2"])
    jPerformReaderOut["PartialTimeStrTokArr2"]:=__MiliSecondsToTime(jPerformReaderOut["PartialTimeStrTokArr2"])

    jPerformReaderOut["TotalTime__StrTokArray"]:=__MiliSecondsToTime(jPerformReaderOut["TotalTime__StrTokArray"])
    jPerformReaderOut["PartialTime__StrTokArray"]:=__MiliSecondsToTime(jPerformReaderOut["PartialTime__StrTokArray"])

    jPerformReaderOut["TotalTimeStrHash"]:=__MiliSecondsToTime(jPerformReaderOut["TotalTimeStrHash"])
    jPerformReaderOut["PartialTimeStrHash"]:=__MiliSecondsToTime(jPerformReaderOut["PartialTimeStrHash"])

    jPerformReaderOut["TotalTimeIsDisqualifiedVerify"]:=__MiliSecondsToTime(jPerformReaderOut["TotalTimeIsDisqualifiedVerify"])
    jPerformReaderOut["PartialTimeIsDisqualifiedVerify"]:=__MiliSecondsToTime(jPerformReaderOut["PartialTimeIsDisqualifiedVerify"])

    jPerformReaderOut["TotalTimeRandom"]:=__MiliSecondsToTime(jPerformReaderOut["TotalTimeRandom"])
    jPerformReaderOut["PartialTimeRandom"]:=__MiliSecondsToTime(jPerformReaderOut["PartialTimeRandom"])

    jPerformReaderOut["TotalTimeLineSize"]:=__MiliSecondsToTime(jPerformReaderOut["TotalTimeLineSize"])
    jPerformReaderOut["PartialTimeLineSize"]:=__MiliSecondsToTime(jPerformReaderOut["PartialTimeLineSize"])

    jPerformReaderOut["TimeOutThresHold"]:=__MiliSecondsToTime(jPerformReaderOut["TimeOutThresHold"])
    jPerformReaderOut["IsDisqualifiedByTimeOut"]:=if(jPerformReaderOut["IsDisqualifiedByTimeOut"],1,0)

    if (cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB")
        jPerformReaderOut["TotalTimeStrTokArrayInDB"]:=__MiliSecondsToTime(jPerformReaderOut["TotalTimeStrTokArrayInDB"])
        jPerformReaderOut["PartialTimeStrTokArrayInDB"]:=__MiliSecondsToTime(jPerformReaderOut["PartialTimeStrTokArrayInDB"])
    endif

    oFileLogger:WriteLine(jPerformReaderOut:ToJSON())

    FreeObj(@jPerformReaderOut)

return

static function __MiliSecondsToTime(nTotalMS as numeric) as character
return(timeCalc():MiliSecsToTime(nTotalMS))

static function __IsDisqualifiedByTimeOut(jPerformReader as json) as logical
    local nTimeCounter:=TimeCounter() as numeric
    local lIsDisqualifiedByTimeOut as logical
    jPerformReader["PartialTimeProc"]:=(nTimeCounter-jPerformReader["ProcStart"])
    lIsDisqualifiedByTimeOut:=(jPerformReader["PartialTimeProc"]>jPerformReader["TimeOutThresHold"])
    jPerformReader["IsDisqualifiedByTimeOut"]:=lIsDisqualifiedByTimeOut
    jPerformReader["PartialTimeIsDisqualifiedVerify"]+=(TimeCounter()-nTimeCounter)
return(lIsDisqualifiedByTimeOut)

static function __Randomize(nX as numeric,nY as numeric,jPerformReader as json) as numeric
    local nTimeCounter:=TimeCounter() as numeric
    local nRandom as numeric
    nRandom:=Randomize(nX,nY)
    jPerformReader["PartialTimeRandom"]+=(TimeCounter()-nTimeCounter)
return(nRandom)

static procedure __GetLineSize(cLine,jPerformReader)
    local nTimeCounter:=TimeCounter() as numeric
    local nLineSize:=Len(cLine) as numeric
    jPerformReader["PartialBytesRead"]+=nLineSize
    if (jPerformReader["MinLineSize"]==0)
        jPerformReader["MinLineSize"]:=nLineSize
    else
        jPerformReader["MinLineSize"]:=Min(jPerformReader["MinLineSize"],Max(nLineSize,jPerformReader["MinLineSize"]))
    endif
    jPerformReader["MaxLineSize"]:=Max(jPerformReader["MaxLineSize"],nLineSize)
    jPerformReader["PartialTimeLineSize"]+=(TimeCounter()-nTimeCounter)
return

static procedure __TST_FT(oFileLogger as object,cFile as character,jPerformReader as json,lSequential as logical,lDecodeUTF8 as logical)

    local cLine as character
    local cLineSkip as character

    local lBreakLine as logical

    local nHandle as numeric

    local nRecNo as numeric
    local nRecNos as numeric

    local oFileNavigator as object

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    lBreakLine:=jPerformReader["HasBreakLine"]

    nHandle:=fOpen(cFile)
    //FT_ nao fornece uma funcao para obter o tamanho do arquivo
    //Vamos emprestar de FileNavigator
    oFileNavigator:=FileNavigator():New(;
        nHandle;
        ,nil;
        ,{||.F.};
        ,{||""};
    )
    jPerformReader["FileSize"]:=oFileNavigator:FileSize()
    oFileNavigator:Close()

    nHandle:=ft_fUse(cFile)

    ft_fGoTop()

    if (!lSequential)
        nRecNos:=ft_fLastRec()
        while (!ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            *****************************************************************
            nRecNo:=ft_fRecNo()
            *****************************************************************
            ft_fSkip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=ft_fReadLN()
            *****************************************************************
            ft_fGoto(nRecNo)
            *****************************************************************
            cLine:=ft_fReadLN()
            if (lBreakLine)
                ft_fSkip()
                cLine+=ft_fReadLN()
            endif
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            __TSTStrTokArray(@cLine,@jPerformReader,lDecodeUTF8)
            *****************************************************************
            ft_fSkip()
        end while
    else
        while (!ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            cLine:=ft_fReadLN()
            if (lBreakLine)
                ft_fSkip()
                cLine+=ft_fReadLN()
            endif
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            __TSTStrTokArray(@cLine,@jPerformReader,lDecodeUTF8)
            *****************************************************************
            ft_fSkip()
        end while
    endif

    ft_fUse()

    jPerformReader:DelName("HasBreakLine")

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader)

return

static procedure __TST_FWFILEREADER(oFileLogger as object,cFile as character,jPerformReader as json,lSequential as logical,lDecodeUTF8 as logical)

    local cLine as character
    local cLineSkip as character

    //FWFILEREADER tem Bug e retorna cCRH10 ou cCRH13 indevidamente e não bate o Hash da Linha
    local cCRH10 as character
    local cCRH13 as character

    local nRecNo as numeric
    local nRecNos as numeric

    local oFileReader as object
    local oFileNavigator as object

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    cCRH10:=CHR(10)
    cCRH13:=CHR(13)

    oFileReader:=FWFileReader():New(cFile)
    oFileReader:Open()

    jPerformReader["FileSize"]:=oFileReader:GetFileSize()

    if (!lSequential)

        oFileNavigator:=FileNavigator():New(;
            oFileReader:nHandLen;
            ,{|nHandle|fSeek(nHandle,0,FS_SET)};
            ,{||!oFileReader:HasLine()};
            ,{||oFileReader:GetLine()};
        )

        if (!lSequential)
            nRecNos:=oFileNavigator:BuildIndex()
        endif

        //Utilizo, agora, FileNavigator para Navegar pelo arquivo
        while (oFileNavigator:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            //Sem suporte a Navegacao no Arquivo. Vamos usar FileNavigator
            *****************************************************************
            nRecNo:=oFileNavigator:RecNo()
            *****************************************************************
            oFileNavigator:Skip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=oFileNavigator:GetLine()
            *****************************************************************
            oFileNavigator:GoTo(nRecNo)
            cLine:=oFileNavigator:GetLine()
            *****************************************************************
            //FWFILEREADER tem Bug e retorna cCRH10 ou cCRH13 indevidamente e não bate o Hash da Linha
            if (cCRH10$cLine)
                cLine:=StrTran(cLine,cCRH10,"")
            endif
            if (cCRH13$cLine)
                cLine:=StrTran(cLine,cCRH13,"")
            endif
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            __TSTStrTokArray(@cLine,@jPerformReader,lDecodeUTF8)
            *****************************************************************
        end while
        oFileNavigator:Close({||oFileReader:Close()})
        FreeObj(@oFileNavigator)
    else
        while (oFileReader:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            //Fix Return Error GetLine(.T.)
            cLine:=oFileReader:GetLine(.T.)
            *****************************************************************
            //FWFILEREADER tem Bug e retorna cCRH10 ou cCRH13 indevidamente e não bate o Hash da Linha
            if (cCRH10$cLine)
                cLine:=StrTran(cLine,cCRH10,"")
            endif
            if (cCRH13$cLine)
                cLine:=StrTran(cLine,cCRH13,"")
            endif
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            __TSTStrTokArray(@cLine,@jPerformReader,lDecodeUTF8)
            *****************************************************************
        end while
    endif

    FreeObj(@oFileReader)

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader)

return

static procedure __TST_TFILEREAD(oFileLogger as object,cFile as character,jPerformReader as json,lSequential as logical,lDecodeUTF8 as logical)

    local cLine as character
    local cLineSkip as character

    local nHandle as numeric

    local nRecNo as numeric
    local nRecNos as numeric

    local oFileReader as object
    local oFileNavigator as object

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    oFileReader:=TFileRead():New(cFile)
    oFileReader:Open()

    jPerformReader["FileSize"]:=oFileReader:FileSize()

    if (!lSequential)

        oFileNavigator:=FileNavigator():New(;
            oFileReader:Handle();
            ,{|nHandle|fSeek(nHandle,0,FS_SET)};
            ,{||!oFileReader:HasLine()};
            ,{||oFileReader:GetLine()};
        )

        nRecNos:=oFileNavigator:BuildIndex()

        //Utilizo, agora, FileNavigator para Navegar pelo arquivo
        while (oFileNavigator:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            //Sem suporte a Navegacao no Arquivo. Vamos usar FileNavigator
            *****************************************************************
            nRecNo:=oFileNavigator:RecNo()
            *****************************************************************
            oFileNavigator:Skip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=oFileNavigator:GetLine()
            *****************************************************************
            oFileNavigator:GoTo(nRecNo)
            cLine:=oFileNavigator:GetLine()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            __TSTStrTokArray(@cLine,@jPerformReader,lDecodeUTF8)
            *****************************************************************
        end while

        oFileNavigator:Close({||oFileReader:Close()})
        FreeObj(@oFileNavigator)

    else

        while (oFileReader:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            cLine:=oFileReader:GetLine()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            __TSTStrTokArray(@cLine,@jPerformReader,lDecodeUTF8)
            *****************************************************************
        end while

    endif

    FreeObj(@oFileReader)

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader)

return

static procedure __TST_FILEREADER(oFileLogger as object,cFile as character,jPerformReader as json,lSequential as logical,lDecodeUTF8 as logical)

    local cLine as character
    local cLineSkip as character

    local oFileReader as object

    local nRecNo as numeric
    local nRecNos as numeric

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    oFileReader:=fileTools():FileReader(jPerformReader["RDD"])
    oFileReader:ft_fUse(cFile)

    jPerformReader["FileSize"]:=oFileReader:ft_fFileSize()

    if (!lSequential)
        nRecNos:=oFileReader:ft_fLastRec()
        while (!oFileReader:ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            *****************************************************************
            nRecNo:=oFileReader:ft_fRecNo()
            *****************************************************************
            oFileReader:ft_fSkip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=oFileReader:ft_fReadLN()
            *****************************************************************
            oFileReader:ft_fGoto(nRecNo)
            *****************************************************************
            cLine:=oFileReader:ft_fReadLN()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            __TSTStrTokArray(@cLine,@jPerformReader,lDecodeUTF8)
            *****************************************************************
            oFileReader:ft_fSkip()
        end while
    else
        while (!oFileReader:ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            cLine:=oFileReader:ft_fReadLN()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            __TSTStrTokArray(@cLine,@jPerformReader,lDecodeUTF8)
            *****************************************************************
            oFileReader:ft_fSkip()
        end while
    endif

    oFileReader:ft_fUse()
    FreeObj(@oFileReader)

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader)

return

static procedure __TST_FILEREADER_StrTokArrayInDB(oFileLogger as object,cFile as character,jPerformReader as json,lSequential as logical,lDecodeUTF8 as logical)

    local aAllTokenizedLines as array

    local cLine as character
    local cLineSkip as character

    local oFileReader as object
    local oStrTokArrayInDB as object

    local nRecNo as numeric
    local nRecNos as numeric

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    oFileReader:=fileTools():FileReader(jPerformReader["RDD"])
    oFileReader:ft_fUse(cFile)

    jPerformReader["FileSize"]:=oFileReader:ft_fFileSize()

    if (!lSequential)
        nRecNos:=oFileReader:ft_fLastRec()
        while (!oFileReader:ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            *****************************************************************
            nRecNo:=oFileReader:ft_fRecNo()
            *****************************************************************
            oFileReader:ft_fSkip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=oFileReader:ft_fReadLN()
            *****************************************************************
            oFileReader:ft_fGoto(nRecNo)
            *****************************************************************
            cLine:=oFileReader:ft_fReadLN()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            oFileReader:ft_fSkip()
        end while
    else
        while (!oFileReader:ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            cLine:=oFileReader:ft_fReadLN()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            oFileReader:ft_fSkip()
        end while
    endif

    jPerformReader["PartialTimeStrTokArrayInDB"]:=TimeCounter()
        oStrTokArrayInDB:=StrTokArrayInDB():New(StrTran(oFileReader:ft_fGetDbFile(),"dbo.",""),"LINE","M","ID")
        if (oStrTokArrayInDB:Tokenize(";"))
            aAllTokenizedLines:=oStrTokArrayInDB:GetAllTokenizedLines()
            aEval(aAllTokenizedLines,{|aLine as array|jPerformReader["PartialStrTokArrayInDB"]+=Len(aLine)})
            FWFreeArray(@aAllTokenizedLines)
        endif
        oStrTokArrayInDB:Close()
        FreeObj(@oStrTokArrayInDB)
    jPerformReader["PartialTimeStrTokArrayInDB"]:=(TimeCounter()-jPerformReader["PartialTimeStrTokArrayInDB"])

    oFileReader:ft_fUse()
    FreeObj(@oFileReader)

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader)

return


static procedure __TST_FILENAVIGATOR(oFileLogger as object,cFile as character,jPerformReader as json,lSequential as logical,lDecodeUTF8 as logical)

    local cLine as character
    local cLineSkip as character

    local nHandle:=(-1) as numeric

    local nRecNo as numeric
    local nRecNos as numeric

    local oFileReadLine as object
    local oFileNavigator as object

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    oFileNavigator:=FileNavigator():New(;
         nHandle;
        ,{|nHandle|fSeek(nHandle,0,FS_SET)};
        ,{||!oFileReadLine:HasLine()};
        ,{||oFileReadLine:GetLine()};
    )

    oFileNavigator:Open(cFile)
    nHandle:=oFileNavigator:Handle()
    jPerformReader["FileSize"]:=oFileNavigator:FileSize()

    oFileReadLine:=FileReadLine():New(nHandle,jPerformReader["FileSize"])

    if (!lSequential)
        nRecNos:=oFileNavigator:BuildIndex()
        while (oFileNavigator:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            //Sem suporte a Navegacao no Arquivo. Vamos usar FileNavigator
            *****************************************************************
            nRecNo:=oFileNavigator:RecNo()
            *****************************************************************
            oFileNavigator:Skip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=oFileNavigator:GetLine()
            *****************************************************************
            oFileNavigator:GoTo(nRecNo)
            cLine:=oFileNavigator:GetLine()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            __TSTStrTokArray(@cLine,@jPerformReader,lDecodeUTF8)
            *****************************************************************
        end while
    else
        while (oFileReadLine:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jPerformReader))
                exit
            endif
            cLine:=oFileReadLine:GetLine()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(if(lDecodeUTF8,DecodeUTF8(cLine),cLine),jPerformReader)
            *****************************************************************
            __TSTStrTokArray(@cLine,@jPerformReader,lDecodeUTF8)
            *****************************************************************
        end while
    endif

    oFileReadLine:Clean()
    FreeObj(@oFileReadLine)

    oFileNavigator:Close()
    FreeObj(@oFileNavigator)

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader)

return
