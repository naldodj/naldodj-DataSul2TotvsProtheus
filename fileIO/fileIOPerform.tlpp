    ,"FT"                               :  {"Owner":"TOTVS  ","Reader":"","RDD":""          ,"Call":3,"TimeProcStart":"","TimeProcEnd":"","PartialTimeProc":0,"TotalTimeProc":0,"PartialTimeReader":0,"TotalTimeReader":0,"PartialTimeStrTokArr":0,"PartialTimeStrTokArr2":0,"PartialTime__StrTokArray":0,"TotalTimeStrTokArr":0,"TotalTimeStrTokArr2":0,"TotalTime__StrTokArray":0,"PartialTimeStrTokArrayInDB":0,"TotalTimeStrTokArrayInDB":0,"PartialTimeStrHash":0,"TotalTimeStrHash":0,"PartialTimeIsDisqualifiedVerify":0,"TotalTimeIsDisqualifiedVerify":0,"PartialTimeRandom":0,"TotalTimeRandom":0,"PartialTimeLineSize":0,"TotalTimeLineSize":0,"StrHash":0,"StrTokArrHash":0,"StrTokArr2Hash":0,"__StrTokArrayHash":0,"IsDisqualifiedByTimeOut":false,"ProcStart":0,"ProcEnd":0,"PartialStrTokArr":0,"PartialStrTokArr2":0,"Partial__StrTokArray":0,"TotalStrTokArr":0,"TotalStrTokArr2":0,"Total__StrTokArray":0,"PartialStrTokArrayInDB":0,"TotalStrTokArrayInDB":0,"Lines":0,"MinLineSize":0,"MaxLineSize":0,"TotalLinesRead":0,"FileSize":0,"PartialBytesRead":0,"TotalBytesRead":0}
}
    endContent

    jPerform:=JSONObject():New()
    jPerform:FromJSON(cPerform)
    aPerform:=jPerform:GetNames()

    for nFile:=1 to Len(jFiles)
        if (!jFiles[nFile]["Process"])
            loop
        endif
        cLine:=""
        cFile:=jFiles[nFile]["File"]
        if ((lStrHashLog).and.(jFiles[nFile]["StrHashLog"]))
            jFiles[nFile]["TimeOutThresHold"]*=4
        else
            jFiles[nFile]["TimeOutThresHold"]*=2
        endif
        for i:=1 to 2
            lExecuteProc:=NTools():ContainN(jFiles[nFile]["Call"],i)
            if (!lExecuteProc)
                loop
            endif
            lSequential:=(i==1)
            oFileLogger:WriteLine("FileName["+cFile+"] "+if(!lSequential,"Not ","")+"Sequential reading")
            for j:=1 to Len(aPerform)
                cFileReader:=aPerform[j]
                //Call: 0-Not Call;1=Sequential;2=Not Sequential;3=Both
                lExecuteProc:=NTools():ContainN(jFiles[nFile]["Call"],jPerform[cFileReader]["Call"])
                if (!lExecuteProc)
                    loop
                endif
                if (cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB")
                    if ("MSSQL"!=cTCGETDB)
                        loop
                    else
                        jPerform[cFileReader]["PartialStrTokArrayInDB"]:=0
                        jPerform[cFileReader]["PartialTimeStrTokArrayInDB"]:=0
                    endif
                endif
                jPerform[cFileReader]["Reader"]:=cFileReader
                jPerform[cFileReader]["Lines"]:=0
                jPerform[cFileReader]["FileSize"]:=0
                jPerform[cFileReader]["PartialBytesRead"]:=0
                jPerform[cFileReader]["MinLineSize"]:=0
                jPerform[cFileReader]["MaxLineSize"]:=0
                jPerform[cFileReader]["PartialStrTokArr"]:=0
                jPerform[cFileReader]["PartialTimeStrTokArr"]:=0
                jPerform[cFileReader]["PartialStrTokArr2"]:=0
                jPerform[cFileReader]["PartialTimeStrTokArr2"]:=0
                jPerform[cFileReader]["Partial__StrTokArray"]:=0
                jPerform[cFileReader]["PartialTime__StrTokArray"]:=0
                jPerform[cFileReader]["StrHash"]:=0
                jPerform[cFileReader]["StrTokArrHash"]:=0
                jPerform[cFileReader]["StrTokArr2Hash"]:=0
                jPerform[cFileReader]["__StrTokArrayHash"]:=0
                jPerform[cFileReader]["PartialTimeStrHash"]:=0
                jPerform[cFileReader]["IsDisqualifiedByTimeOut"]:=.F.
                jPerform[cFileReader]["PartialTimeIsDisqualifiedVerify"]:=0
                jPerform[cFileReader]["PartialTimeRandom"]:=0
                jPerform[cFileReader]["PartialTimeLineSize"]:=0
                if ((lStrHashLog).and.(jFiles[nFile]["StrHashLog"]))
                    jPerform[cFileReader]["StrHashLoggerFile"]:=__HashLoggerFile(cFile+"."+cFileReader+"."+StrTran(Time(),":","")+"."+UUIDRandomSeq()+".log")
                    jPerform[cFileReader]["StrHashLogger"]:=FileLogger():New(jPerform[cFileReader]["StrHashLoggerFile"])
                endif
                if (cFileReader=="FT")
                    jPerform[cFileReader]["HasBreakLine"]:=jFiles[nFile]["HasBreakLine"]
                    __TST_FT(oFileLogger,jFiles[nFile],jPerform[cFileReader],lSequential)
                elseif (cFileReader=="FWFILEREADER")
                    __TST_FWFILEREADER(oFileLogger,jFiles[nFile],jPerform[cFileReader],lSequential)
                elseif (cFileReader=="TFILEREAD")
                    __TST_TFILEREAD(oFileLogger,jFiles[nFile],jPerform[cFileReader],lSequential)
                elseif (cFileReader=="FILENAVIGATOR")
                    __TST_FILENAVIGATOR(oFileLogger,jFiles[nFile],jPerform[cFileReader],lSequential)
                elseif (cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB")
                    __TST_FILEREADER_StrTokArrayInDB(oFileLogger,jFiles[nFile],jPerform[cFileReader],lSequential)
                else
                    __TST_FILEREADER(oFileLogger,jFiles[nFile],jPerform[cFileReader],lSequential)
                endif
            next j
        next i
        oFileLogger:WriteLine("")
    next nFile

    __SendToLogger(oFileLogger,jPerform,3)

    oFileLogger:Close()
    FreeObj(@oFileLogger)

    if (DirTools():MakeFileDir("c:"+cFileLogger))
        __CopyFile(cFileLogger,"c:"+cFileLogger)
        fErase(cFileLogger)
    endif

    FWFreeArray(@jFiles)

    FWFreeArray(@aPerform)

    FreeObj(@jPerform)

return

static function __HashLoggerFile(cFile as character)
    local cSPPDrive as character
    local cSPPPath as character
    local cSPPFile as character
    local cSPPExt as character
    SplitPath(cFile,@cSPPDrive,@cSPPPath,@cSPPFile,@cSPPExt)
    cFile:="\tmp\"
    cFile+=cSPPFile
    cFile+=cSPPExt
    DirTools():MakeFileDir(cFile)
return(cFile)

static procedure __TSTStrTokArray(cLine as character,jFile as json,jPerformReader as json)

    local aLine as array

    local cToken:=jFile["Token"] as character
    local cLineStrHash as character

    local nStrTokTime as numeric

    *****************************************************************
    //Remove Tokens Desnecessários
    if ("fulltablesdefinition.txt"$jFile["File"])
        cLine:=cTools():StrReplace(cLine,{"  "," "})
    endif
    *****************************************************************
    nStrTokTime:=TimeCounter()
        aLine:=StrTokArr(cLine,cToken)
        cLineStrHash:=""
        aEval(aLine,{|e as character|cLineStrHash+=(e+cToken)})
        cLineStrHash:=StrTran(cLineStrHash,cLine,"")
        if (cLineStrHash==cToken)
            cLineStrHash:=""
        endif
        jPerformReader["PartialStrTokArr"]+=Len(aLine)
        FWFreeArray(@aLine)
    jPerformReader["PartialTimeStrTokArr"]+=(TimeCounter()-nStrTokTime)
    *****************************************************************
    if (Len(cLineStrHash)>0)
        __StrHashTokArr(cLineStrHash,jPerformReader,"StrTokArr")
    endif
    *****************************************************************
    nStrTokTime:=TimeCounter()
        aLine:=StrTokArr2(cLine,cToken,.T.)
        cLineStrHash:=""
        aEval(aLine,{|e as character|cLineStrHash+=(e+cToken)})
        cLineStrHash:=StrTran(cLineStrHash,cLine,"")
        if (cLineStrHash==cToken)
            cLineStrHash:=""
        endif
        if ("fulltablesdefinition.txt"$jFile["File"])
            aEval(aLine,{|e as character|jPerformReader["PartialStrTokArr2"]+=if(e=="",0,1)})
        else
            jPerformReader["PartialStrTokArr2"]+=Len(aLine)
        endif
        FWFreeArray(@aLine)
    jPerformReader["PartialTimeStrTokArr2"]+=(TimeCounter()-nStrTokTime)
    *****************************************************************
    if (Len(cLineStrHash)>0)
        __StrHashTokArr(cLineStrHash,jPerformReader,"StrTokArr2")
    endif
    *****************************************************************
    nStrTokTime:=TimeCounter()
        aLine:=cTools():__StrTokArray(cLine,cToken)
        cLineStrHash:=""
        aEval(aLine,{|e as character|cLineStrHash+=(e+cToken)})
        cLineStrHash:=StrTran(cLineStrHash,cLine,"")
        if (cLineStrHash==cToken)
            cLineStrHash:=""
        endif
        if ("fulltablesdefinition.txt"$jFile["File"])
            aEval(aLine,{|e as character|jPerformReader["Partial__StrTokArray"]+=if(e=="",0,1)})
        else
            jPerformReader["Partial__StrTokArray"]+=Len(aLine)
        endif
        FWFreeArray(@aLine)
    jPerformReader["PartialTime__StrTokArray"]+=(TimeCounter()-nStrTokTime)
    *****************************************************************
    if (Len(cLineStrHash)>0)
        __StrHashTokArr(cLineStrHash,jPerformReader,"__StrTokArray")
    endif
    *****************************************************************

return

static procedure __StrHash(cStr as character,jFile as json,jPerformReader as json)
    local nPartialTimeStrHash:=TimeCounter() as numeric
    local lStrHashLog:=jFile["StrHashLog"] as logical
    local lDecodeUTF8:=jFile["DecodeUTF8"] as logical
    local nStrHash as numeric
    nStrHash:=cTools():StrHash(if(lDecodeUTF8,DecodeUTF8(cStr),cStr))
    jPerformReader["StrHash"]+=nStrHash
    if (lStrHashLog)
        jPerformReader["StrHashLogger"]:WriteLine(StrZero(nStrHash,16)+" "+cStr)
    endif
    jPerformReader["PartialTimeStrHash"]+=(TimeCounter()-nPartialTimeStrHash)
return

static procedure __StrHashTokArr(cStr as character,jPerformReader as json,cTokArr as character)
    local nStrHash as numeric
    local nPartialTimeStrHash:=TimeCounter() as numeric
    nStrHash:=cTools():StrHash(cStr)
    jPerformReader[cTokArr+"Hash"]+=nStrHash
    jPerformReader["PartialTimeStrHash"]+=(TimeCounter()-nPartialTimeStrHash)
return

static procedure __SendToLogger(oFileLogger as object,jLogger as json,nOption as numeric)

    local aLoggerItem as array
    local aLoggerPerform as array

    local cName as character
    local cFileReader as character

    local jLoggerOut as json

    local lStrHashLog as logical

    local i,j as numeric

    if (nOption==1)

        jLoggerOut:=JSONObjectClone():CloneJSON(jLogger)

        for i:=1 to Len(jLoggerOut)
            jLoggerOut[i]["TimeOutThresHold"]:=__MiliSecondsToTime(jLoggerOut[i]["TimeOutThresHold"])
        next i

    elseif (nOption==2)

        cFileReader:=jLogger["Reader"]

        jLogger["PartialTimeProc"]:=(jLogger["ProcEnd"]-jLogger["ProcStart"])
        jLogger["PartialTimeReader"]:=(;
            jLogger["PartialTimeProc"]-(;
                jLogger["PartialTimeStrTokArr"];
            +jLogger["PartialTimeStrTokArr2"];
            +jLogger["PartialTime__StrTokArray"];
            +jLogger["PartialTimeStrHash"];
            +jLogger["PartialTimeIsDisqualifiedVerify"];
            +jLogger["PartialTimeRandom"];
            +jLogger["PartialTimeLineSize"];
            +if(cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB",jLogger["PartialTimeStrTokArrayInDB"],0);
            );
        )

        jLogger["TotalTimeProc"]+=jLogger["PartialTimeProc"]
        jLogger["TotalTimeReader"]+=jLogger["PartialTimeReader"]
        jLogger["TotalTimeStrTokArr"]+=jLogger["PartialTimeStrTokArr"]
        jLogger["TotalTimeStrTokArr2"]+=jLogger["PartialTimeStrTokArr2"]
        jLogger["TotalTime__StrTokArray"]+=jLogger["PartialTime__StrTokArray"]

        jLogger["TotalStrTokArr"]+=jLogger["PartialStrTokArr"]
        jLogger["TotalStrTokArr2"]+=jLogger["PartialStrTokArr2"]
        jLogger["Total__StrTokArray"]+=jLogger["Partial__StrTokArray"]

        jLogger["TotalLinesRead"]+=jLogger["Lines"]
        jLogger["TotalBytesRead"]+=jLogger["PartialBytesRead"]

        jLogger["TotalTimeStrHash"]+=jLogger["PartialTimeStrHash"]

        jLogger["TotalTimeIsDisqualifiedVerify"]+=jLogger["PartialTimeIsDisqualifiedVerify"]

        jLogger["TotalTimeRandom"]+=jLogger["PartialTimeRandom"]

        jLogger["TotalTimeLineSize"]+=jLogger["PartialTimeLineSize"]

        if (cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB")
            jLogger["TotalStrTokArrayInDB"]+=jLogger["PartialStrTokArrayInDB"]
            jLogger["TotalTimeStrTokArrayInDB"]+=jLogger["PartialTimeStrTokArrayInDB"]
        endif

        lStrHashLog:=jLogger["StrHashLog"]
        if (lStrHashLog)
            jLogger["StrHashLogger"]:Close()
            FreeObj(@jLogger["StrHashLogger"])
            DirTools():MakeFileDir("c:\"+jLogger["StrHashLoggerFile"])
            if (__CopyFile(jLogger["StrHashLoggerFile"],"c:\"+jLogger["StrHashLoggerFile"]))
                fErase(jLogger["StrHashLoggerFile"])
            endif
            jLogger:DelName("StrHashLogger")
            jLogger:DelName("StrHashLoggerFile")
        endif
        jLogger:DelName("StrHashLog")

        jLoggerOut:=JSONObjectClone():CloneJSON(jLogger)

        jLoggerOut["Reader"]:=PadR(jLoggerOut["Reader"],29)
        jLoggerOut["Owner"]:=PadR(jLoggerOut["Owner"],7)
        jLoggerOut["RDD"]:=PadR(jLoggerOut["RDD"],10)

        jLoggerOut["PartialTimeProc"]:=__MiliSecondsToTime(jLoggerOut["PartialTimeProc"])
        jLoggerOut["PartialTimeReader"]:=__MiliSecondsToTime(jLoggerOut["PartialTimeReader"])
        jLoggerOut["PartialTimeStrTokArr"]:=__MiliSecondsToTime(jLoggerOut["PartialTimeStrTokArr"])
        jLoggerOut["PartialTimeStrTokArr2"]:=__MiliSecondsToTime(jLoggerOut["PartialTimeStrTokArr2"])
        jLoggerOut["PartialTime__StrTokArray"]:=__MiliSecondsToTime(jLoggerOut["PartialTime__StrTokArray"])
        jLoggerOut["PartialTimeStrHash"]:=__MiliSecondsToTime(jLoggerOut["PartialTimeStrHash"])
        jLoggerOut["PartialTimeIsDisqualifiedVerify"]:=__MiliSecondsToTime(jLoggerOut["PartialTimeIsDisqualifiedVerify"])
        jLoggerOut["PartialTimeRandom"]:=if(jLoggerOut["PartialTimeRandom"]==0,"00:00:00:00.000000",__MiliSecondsToTime(jLoggerOut["PartialTimeRandom"]))
        jLoggerOut["PartialTimeLineSize"]:=__MiliSecondsToTime(jLoggerOut["PartialTimeLineSize"])

        jLoggerOut["IsDisqualifiedByTimeOut"]:=if(jLoggerOut["IsDisqualifiedByTimeOut"],1,0)

        if (cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB")
            jLoggerOut["PartialTimeStrTokArrayInDB"]:=__MiliSecondsToTime(jLoggerOut["PartialTimeStrTokArrayInDB"])
            //Only to a Pretty Print
            jLoggerOut["PartialTimeStrTokArr"]:="00:00:00:00.000000"
            jLoggerOut["PartialTimeStrTokArr2"]:="00:00:00:00.000000"
            jLoggerOut["PartialTime__StrTokArray"]:="00:00:00:00.000000"
        else
            //Only to a Pretty Print
            jLoggerOut["PartialTimeStrTokArrayInDB"]:="00:00:00:00.000000"
        endif

        aLoggerItem:=jLoggerOut:GetNames()
            for i:=1 to Len(aLoggerItem)
                cName:=aLoggerItem[i]
                if ("Total"$cName)
                    jLoggerOut:DelName(cName)
                endif
            next i
        FWFreeArray(@aLoggerItem)

    elseif (nOption==3)

        jLoggerOut:=JSONObjectClone():CloneJSON(jLogger)

        aLoggerPerform:=jLoggerOut:GetNames()
        for i:=1 to Len(aLoggerPerform)
            cFileReader:=aLoggerPerform[i]
            if (jLoggerOut[cFileReader]["TotalTimeReader"]==0)
                jLoggerOut:DelName(cFileReader)
                loop
            endif
            jLoggerOut[cFileReader]["TotalElapTimeReader"]:=__MiliSecondsToTime(jLoggerOut[cFileReader]["TotalTimeReader"])
            aLoggerItem:=jLoggerOut[cFileReader]:GetNames()
            for j:=1 to Len(aLoggerItem)
                cName:=aLoggerItem[j]
                if (!"Total"$cName)
                    jLoggerOut[cFileReader]:DelName(cName)
                endif
            next j
            FWFreeArray(@aLoggerItem)
            jLoggerOut[cFileReader]["TotalTimeProc"]:=__MiliSecondsToTime(jLoggerOut[cFileReader]["TotalTimeProc"])
            jLoggerOut[cFileReader]["TotalTimeReader"]:=__MiliSecondsToTime(jLoggerOut[cFileReader]["TotalTimeReader"])
            jLoggerOut[cFileReader]["TotalTimeStrTokArr"]:=__MiliSecondsToTime(jLoggerOut[cFileReader]["TotalTimeStrTokArr"])
            jLoggerOut[cFileReader]["TotalTimeStrTokArr2"]:=__MiliSecondsToTime(jLoggerOut[cFileReader]["TotalTimeStrTokArr2"])
            jLoggerOut[cFileReader]["TotalTime__StrTokArray"]:=__MiliSecondsToTime(jLoggerOut[cFileReader]["TotalTime__StrTokArray"])
            jLoggerOut[cFileReader]["TotalTimeStrHash"]:=__MiliSecondsToTime(jLoggerOut[cFileReader]["TotalTimeStrHash"])
            jLoggerOut[cFileReader]["TotalTimeIsDisqualifiedVerify"]:=__MiliSecondsToTime(jLoggerOut[cFileReader]["TotalTimeIsDisqualifiedVerify"])
            jLoggerOut[cFileReader]["TotalTimeRandom"]:=if(jLoggerOut[cFileReader]["TotalTimeRandom"]==0,"00:00:00:00.000000",__MiliSecondsToTime(jLoggerOut["TotalTimeRandom"]))
            jLoggerOut[cFileReader]["TotalTimeLineSize"]:=__MiliSecondsToTime(jLoggerOut[cFileReader]["TotalTimeLineSize"])
            if (cFileReader=="FILEREADER_TOPCONN_TOKARRAYDB")
                jLoggerOut[cFileReader]["TotalTimeStrTokArrayInDB"]:=__MiliSecondsToTime(jLoggerOut[cFileReader]["TotalTimeStrTokArrayInDB"])
            else
                //Only to a Pretty Print
                jLoggerOut[cFileReader]["TotalTimeStrTokArrayInDB"]:="00:00:00:00.000000"
            endif
        next i

    endif

    oFileLogger:WriteLine(if((nOption==1),JSONTools():JSONPrettify(jLoggerOut:ToJSON()),jLoggerOut:ToJSON()))

    FreeObj(@jLoggerOut)

return

static function __MiliSecondsToTime(nTotalMS as numeric) as character
return(timeCalc():MiliSecsToTime(nTotalMS))

static function __IsDisqualifiedByTimeOut(jFile as json,jPerformReader as json) as logical
    local nTimeCounter:=TimeCounter() as numeric
    local lIsDisqualifiedByTimeOut as logical
    jPerformReader["PartialTimeProc"]:=(nTimeCounter-jPerformReader["ProcStart"])
    lIsDisqualifiedByTimeOut:=(jPerformReader["PartialTimeProc"]>jFile["TimeOutThresHold"])
    jPerformReader["IsDisqualifiedByTimeOut"]:=lIsDisqualifiedByTimeOut
    jPerformReader["PartialTimeIsDisqualifiedVerify"]+=(TimeCounter()-nTimeCounter)
return(lIsDisqualifiedByTimeOut)

static function __Randomize(nX as numeric,nY as numeric,jPerformReader as json) as numeric
    local nTimeCounter:=TimeCounter() as numeric
    local nRandom as numeric
    nRandom:=Randomize(nX,nY)
    jPerformReader["PartialTimeRandom"]+=(TimeCounter()-nTimeCounter)
return(nRandom)

static procedure __GetLineSize(cLine,jPerformReader)
    local nTimeCounter:=TimeCounter() as numeric
    local nLineSize:=Len(cLine) as numeric
    jPerformReader["PartialBytesRead"]+=nLineSize
    if (jPerformReader["MinLineSize"]==0)
        jPerformReader["MinLineSize"]:=nLineSize
    else
        jPerformReader["MinLineSize"]:=Min(jPerformReader["MinLineSize"],Max(nLineSize,jPerformReader["MinLineSize"]))
    endif
    jPerformReader["MaxLineSize"]:=Max(jPerformReader["MaxLineSize"],nLineSize)
    jPerformReader["PartialTimeLineSize"]+=(TimeCounter()-nTimeCounter)
return

static procedure __TST_FT(oFileLogger as object,jFile as json,jPerformReader as json,lSequential as logical)

    local cFile:=jFile["File"] as character
    local cLine as character
    local cLineSkip as character

    local lBreakLine as logical

    local nHandle as numeric

    local nRecNo as numeric
    local nRecNos as numeric

    local oFileNavigator as object

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    lBreakLine:=jPerformReader["HasBreakLine"]

    nHandle:=fOpen(cFile)
    //FT_ nao fornece uma funcao para obter o tamanho do arquivo
    //Vamos emprestar de FileNavigator
    oFileNavigator:=FileNavigator():New(;
        nHandle;
        ,nil;
        ,{||.F.};
        ,{||""};
    )
    jPerformReader["FileSize"]:=oFileNavigator:FileSize()
    oFileNavigator:Close()

    nHandle:=ft_fUse(cFile)

    ft_fGoTop()

    if (!lSequential)
        nRecNos:=ft_fLastRec()
        while (!ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            *****************************************************************
            nRecNo:=ft_fRecNo()
            *****************************************************************
            ft_fSkip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=ft_fReadLN()
            *****************************************************************
            ft_fGoto(nRecNo)
            *****************************************************************
            cLine:=ft_fReadLN()
            if (lBreakLine)
                ft_fSkip()
                cLine+=ft_fReadLN()
            endif
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            __TSTStrTokArray(cLine,jFile,jPerformReader)
            *****************************************************************
            ft_fSkip()
        end while
    else
        while (!ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            cLine:=ft_fReadLN()
            if (lBreakLine)
                ft_fSkip()
                cLine+=ft_fReadLN()
            endif
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            __TSTStrTokArray(cLine,jFile,jPerformReader)
            *****************************************************************
            ft_fSkip()
        end while
    endif

    ft_fUse()

    jPerformReader:DelName("HasBreakLine")

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader,2)

return

static procedure __TST_FWFILEREADER(oFileLogger as object,jFile as json,jPerformReader as json,lSequential as logical)

    local cFile:=jFile["File"] as character
    local cLine as character
    local cLineSkip as character

    //FWFILEREADER tem Bug e retorna cCRH10 ou cCRH13 indevidamente e não bate o Hash da Linha
    local cCRH10 as character
    local cCRH13 as character

    local nRecNo as numeric
    local nRecNos as numeric

    local oFileReader as object
    local oFileNavigator as object

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    cCRH10:=CHR(10)
    cCRH13:=CHR(13)

    oFileReader:=FWFileReader():New(cFile)
    oFileReader:Open()

    jPerformReader["FileSize"]:=oFileReader:GetFileSize()

    if (!lSequential)

        oFileNavigator:=FileNavigator():New(;
            oFileReader:nHandLen;
            ,{|nHandle|fSeek(nHandle,0,FS_SET)};
            ,{||!oFileReader:HasLine()};
            ,{||oFileReader:GetLine()};
        )

        if (!lSequential)
            nRecNos:=oFileNavigator:BuildIndex()
        endif

        //Utilizo, agora, FileNavigator para Navegar pelo arquivo
        while (oFileNavigator:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            //Sem suporte a Navegacao no Arquivo. Vamos usar FileNavigator
            *****************************************************************
            nRecNo:=oFileNavigator:RecNo()
            *****************************************************************
            oFileNavigator:Skip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=oFileNavigator:GetLine()
            *****************************************************************
            oFileNavigator:GoTo(nRecNo)
            cLine:=oFileNavigator:GetLine()
            *****************************************************************
            //FWFILEREADER tem Bug e retorna cCRH10 ou cCRH13 indevidamente e não bate o Hash da Linha
            if (cCRH10$cLine)
                cLine:=StrTran(cLine,cCRH10,"")
            endif
            if (cCRH13$cLine)
                cLine:=StrTran(cLine,cCRH13,"")
            endif
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            __TSTStrTokArray(cLine,jFile,jPerformReader)
            *****************************************************************
        end while
        oFileNavigator:Close({||oFileReader:Close()})
        FreeObj(@oFileNavigator)
    else
        while (oFileReader:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            //Fix Return Error GetLine(.T.)
            cLine:=oFileReader:GetLine(.T.)
            *****************************************************************
            //FWFILEREADER tem Bug e retorna cCRH10 ou cCRH13 indevidamente e não bate o Hash da Linha
            if (cCRH10$cLine)
                cLine:=StrTran(cLine,cCRH10,"")
            endif
            if (cCRH13$cLine)
                cLine:=StrTran(cLine,cCRH13,"")
            endif
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            __TSTStrTokArray(cLine,jFile,jPerformReader)
            *****************************************************************
        end while
    endif

    FreeObj(@oFileReader)

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader,2)

return

static procedure __TST_TFILEREAD(oFileLogger as object,jFile as json,jPerformReader as json,lSequential as logical)

    local cFile:=jFile["File"] as character
    local cLine as character
    local cLineSkip as character

    local nHandle as numeric

    local nRecNo as numeric
    local nRecNos as numeric

    local oFileReader as object
    local oFileNavigator as object

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    oFileReader:=TFileRead():New(cFile)
    oFileReader:Open()

    jPerformReader["FileSize"]:=oFileReader:FileSize()

    if (!lSequential)

        oFileNavigator:=FileNavigator():New(;
            oFileReader:Handle();
            ,{|nHandle|fSeek(nHandle,0,FS_SET)};
            ,{||!oFileReader:HasLine()};
            ,{||oFileReader:GetLine()};
        )

        nRecNos:=oFileNavigator:BuildIndex()

        //Utilizo, agora, FileNavigator para Navegar pelo arquivo
        while (oFileNavigator:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            //Sem suporte a Navegacao no Arquivo. Vamos usar FileNavigator
            *****************************************************************
            nRecNo:=oFileNavigator:RecNo()
            *****************************************************************
            oFileNavigator:Skip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=oFileNavigator:GetLine()
            *****************************************************************
            oFileNavigator:GoTo(nRecNo)
            cLine:=oFileNavigator:GetLine()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            __TSTStrTokArray(cLine,jFile,jPerformReader)
            *****************************************************************
        end while

        oFileNavigator:Close({||oFileReader:Close()})
        FreeObj(@oFileNavigator)

    else

        while (oFileReader:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            cLine:=oFileReader:GetLine()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            __TSTStrTokArray(cLine,jFile,jPerformReader)
            *****************************************************************
        end while

    endif

    FreeObj(@oFileReader)

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader,2)

return

static procedure __TST_FILEREADER(oFileLogger as object,jFile as json,jPerformReader as json,lSequential as logical)

    local cFile:=jFile["File"] as character
    local cLine as character
    local cLineSkip as character

    local oFileReader as object

    local nRecNo as numeric
    local nRecNos as numeric

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    oFileReader:=fileTools():FileReader(jPerformReader["RDD"])
    oFileReader:ft_fUse(cFile)

    jPerformReader["FileSize"]:=oFileReader:ft_fFileSize()

    if (!lSequential)
        nRecNos:=oFileReader:ft_fLastRec()
        while (!oFileReader:ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            *****************************************************************
            nRecNo:=oFileReader:ft_fRecNo()
            *****************************************************************
            oFileReader:ft_fSkip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=oFileReader:ft_fReadLN()
            *****************************************************************
            oFileReader:ft_fGoto(nRecNo)
            *****************************************************************
            cLine:=oFileReader:ft_fReadLN()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            __TSTStrTokArray(cLine,jFile,jPerformReader)
            *****************************************************************
            oFileReader:ft_fSkip()
        end while
    else
        while (!oFileReader:ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            cLine:=oFileReader:ft_fReadLN()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            __TSTStrTokArray(cLine,jFile,jPerformReader)
            *****************************************************************
            oFileReader:ft_fSkip()
        end while
    endif

    oFileReader:ft_fUse()
    FreeObj(@oFileReader)

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader,2)

return

static procedure __TST_FILEREADER_StrTokArrayInDB(oFileLogger as object,jFile as json,jPerformReader as json,lSequential as logical)

    local aAllTokenizedLines as array

    local cFile:=jFile["File"] as character
    local cLine as character
    local cLineSkip as character

    local oFileReader as object
    local oStrTokArrayInDB as object

    local nRecNo as numeric
    local nRecNos as numeric

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    oFileReader:=fileTools():FileReader(jPerformReader["RDD"])
    oFileReader:ft_fUse(cFile)

    jPerformReader["FileSize"]:=oFileReader:ft_fFileSize()

    if (!lSequential)
        nRecNos:=oFileReader:ft_fLastRec()
        while (!oFileReader:ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            *****************************************************************
            nRecNo:=oFileReader:ft_fRecNo()
            *****************************************************************
            oFileReader:ft_fSkip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=oFileReader:ft_fReadLN()
            *****************************************************************
            oFileReader:ft_fGoto(nRecNo)
            *****************************************************************
            cLine:=oFileReader:ft_fReadLN()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            oFileReader:ft_fSkip()
        end while
    else
        while (!oFileReader:ft_fEof())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            cLine:=oFileReader:ft_fReadLN()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            oFileReader:ft_fSkip()
        end while
    endif

    jPerformReader["PartialTimeStrTokArrayInDB"]:=TimeCounter()
        oStrTokArrayInDB:=StrTokArrayInDB():New(StrTran(oFileReader:ft_fGetDbFile(),"dbo.",""),"LINE","M","ID")
        if ("fulltablesdefinition.txt"$jFile["File"])
            oStrTokArrayInDB:RemoveExtraTokens(jFile["Token"])
        endif
        if (oStrTokArrayInDB:Tokenize(jFile["Token"]))
            aAllTokenizedLines:=oStrTokArrayInDB:GetAllTokenizedLines()
            aEval(;
                aAllTokenizedLines;
               ,{|aLine as array|;
                    aEval(aLine,{|e as character|jPerformReader["PartialStrTokArrayInDB"]+=if(e=="",0,1)});
                    ,FWFreeArray(@aLine);
                };
            )
            FWFreeArray(@aAllTokenizedLines)
        endif
        oStrTokArrayInDB:Close()
        FreeObj(@oStrTokArrayInDB)
    jPerformReader["PartialTimeStrTokArrayInDB"]:=(TimeCounter()-jPerformReader["PartialTimeStrTokArrayInDB"])

    oFileReader:ft_fUse()
    FreeObj(@oFileReader)

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader,2)

return

static procedure __TST_FILENAVIGATOR(oFileLogger as object,jFile as json,jPerformReader as json,lSequential as logical)

    local cFile:=jFile["File"] as character
    local cLine as character
    local cLineSkip as character

    local nHandle:=(-1) as numeric

    local nRecNo as numeric
    local nRecNos as numeric

    local oFileReadLine as object
    local oFileNavigator as object

    jPerformReader["ProcStart"]:=TimeCounter()
    jPerformReader["TimeProcStart"]:=Time()

    oFileNavigator:=FileNavigator():New(;
         nHandle;
        ,{|nHandle|fSeek(nHandle,0,FS_SET)};
        ,{||!oFileReadLine:HasLine()};
        ,{||oFileReadLine:GetLine()};
    )

    oFileNavigator:Open(cFile)
    nHandle:=oFileNavigator:Handle()
    jPerformReader["FileSize"]:=oFileNavigator:FileSize()

    oFileReadLine:=FileReadLine():New(nHandle,jPerformReader["FileSize"])

    if (!lSequential)
        nRecNos:=oFileNavigator:BuildIndex()
        while (oFileNavigator:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            *****************************************************************
            //Teste de Navegacao
            //Sem suporte a Navegacao no Arquivo. Vamos usar FileNavigator
            *****************************************************************
            nRecNo:=oFileNavigator:RecNo()
            *****************************************************************
            oFileNavigator:Skip(__Randomize(1,nRecNos,jPerformReader))
            cLineSkip:=oFileNavigator:GetLine()
            *****************************************************************
            oFileNavigator:GoTo(nRecNo)
            cLine:=oFileNavigator:GetLine()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            __TSTStrTokArray(cLine,jFile,jPerformReader)
            *****************************************************************
        end while
    else
        while (oFileReadLine:HasLine())
            *****************************************************************
            jPerformReader["Lines"]++
            *****************************************************************
            if (__IsDisqualifiedByTimeOut(jFile,jPerformReader))
                exit
            endif
            cLine:=oFileReadLine:GetLine()
            *****************************************************************
            __GetLineSize(cLine,jPerformReader)
            *****************************************************************
            __StrHash(cLine,jFile,jPerformReader)
            *****************************************************************
            __TSTStrTokArray(cLine,jFile,jPerformReader)
            *****************************************************************
        end while
    endif

    oFileReadLine:Clean()
    FreeObj(@oFileReadLine)

    oFileNavigator:Close()
    FreeObj(@oFileNavigator)

    jPerformReader["TimeProcEnd"]:=Time()
    jPerformReader["ProcEnd"]:=TimeCounter()

    __SendToLogger(oFileLogger,jPerformReader,2)

return
