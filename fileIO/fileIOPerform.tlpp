#include "totvs.ch"
#include "fileio.ch"
#include "jsonarray.ch"

using namespace dna.tech

//FWFILEREADER tem Bug e retorna __cCRH10 ou __cCRH13 indevidamente e não bate o Hash da Linha
static __cCRH10:=CHR(10) as character
static __cCRH13:=CHR(13) as character

procedure u_fileIOPF()
    __cInternet:=nil
    u_fileIOPerform()
return

procedure u_fileIOPerform()
    __cInternet:=nil
    FWMsgRun(nil,{||__fileIOPerform()},"fileIOPerform","Aguarde...")
return

static procedure __fileIOPerform()

    local aFiles:={;
        "\datasul2protheus\tables\funcionario.csv";
       ,"\datasul2protheus\tablesdefinition\fulltablesdefinition.txt";
       ,"\datasul2protheus\tablessplit\movto_calcul_func\movto_calcul_func_001_20250618_155811_573656_288.csv";
       ,"\datasul2protheus\tablessplit\marcac_ptoelet\marcac_ptoelet_001_20250618_155833_573656_984.csv";
    } as array

    local aPerform as array
    local aProperties as array

    local cLine as character
    local cFile as character
    local cPerform as character
    local cProperty as character
    local cFileReader as character

    local jPerform as json

    local lStrHashLog:=.F. as logical

    local nFile as numeric
    local nRecNo as numeric
    local nRecNos as numeric
    local nHandle as numeric

    local oPerform as object
    local oFileReader as object
    local oFileNavigator as object

    local i,j as numeric

    beginContent var cPerform
{
     "TFILEREAD"            :  {"Reader":"","Call":true,"ProcStart":0,"ProcEnd":0,"ProcTime":0,"ReaderTime":0,"ReaderTotalTime":0,"RDD":""           ,"StrTokArrTotal":0,"StrTokArr2Total":0,"__StrTokArrayTotal":0,"StrTokArrTime":0,"StrTokArr2Time":0,"__StrTokArrayTime":0}
    ,"FWFILEREADER"         :  {"Reader":"","Call":true,"ProcStart":0,"ProcEnd":0,"ProcTime":0,"ReaderTime":0,"ReaderTotalTime":0,"RDD":""           ,"StrTokArrTotal":0,"StrTokArr2Total":0,"__StrTokArrayTotal":0,"StrTokArrTime":0,"StrTokArr2Time":0,"__StrTokArrayTime":0}
    ,"FILEREADER_FILE"      :  {"Reader":"","Call":true,"ProcStart":0,"ProcEnd":0,"ProcTime":0,"ReaderTime":0,"ReaderTotalTime":0,"RDD":"FILE"       ,"StrTokArrTotal":0,"StrTokArr2Total":0,"__StrTokArrayTotal":0,"StrTokArrTime":0,"StrTokArr2Time":0,"__StrTokArrayTime":0}
    ,"FILEREADER_HASHMAP"   :  {"Reader":"","Call":true,"ProcStart":0,"ProcEnd":0,"ProcTime":0,"ReaderTime":0,"ReaderTotalTime":0,"RDD":"HASHMAP"    ,"StrTokArrTotal":0,"StrTokArr2Total":0,"__StrTokArrayTotal":0,"StrTokArrTime":0,"StrTokArr2Time":0,"__StrTokArrayTime":0}
    ,"FILEREADER_SQLITE_MEM":  {"Reader":"","Call":true,"ProcStart":0,"ProcEnd":0,"ProcTime":0,"ReaderTime":0,"ReaderTotalTime":0,"RDD":"SQLITE_MEM" ,"StrTokArrTotal":0,"StrTokArr2Total":0,"__StrTokArrayTotal":0,"StrTokArrTime":0,"StrTokArr2Time":0,"__StrTokArrayTime":0}
    ,"FILEREADER_SQLITE_TMP":  {"Reader":"","Call":true,"ProcStart":0,"ProcEnd":0,"ProcTime":0,"ReaderTime":0,"ReaderTotalTime":0,"RDD":"SQLITE_TMP" ,"StrTokArrTotal":0,"StrTokArr2Total":0,"__StrTokArrayTotal":0,"StrTokArrTime":0,"StrTokArr2Time":0,"__StrTokArrayTime":0}
    ,"FILEREADER_TOPCONN"   :  {"Reader":"","Call":true,"ProcStart":0,"ProcEnd":0,"ProcTime":0,"ReaderTime":0,"ReaderTotalTime":0,"RDD":"TOPCONN"    ,"StrTokArrTotal":0,"StrTokArr2Total":0,"__StrTokArrayTotal":0,"StrTokArrTime":0,"StrTokArr2Time":0,"__StrTokArrayTime":0}
    ,"FT"                   :  {"Reader":"","Call":true,"ProcStart":0,"ProcEnd":0,"ProcTime":0,"ReaderTime":0,"ReaderTotalTime":0,"RDD":""           ,"StrTokArrTotal":0,"StrTokArr2Total":0,"__StrTokArrayTotal":0,"StrTokArrTime":0,"StrTokArr2Time":0,"__StrTokArrayTime":0}
}
    endContent

    //Uso JSONArray para dar suporte a JSONObject do protheus.
    //Ele se perde ao renderizar o JSON acima
    //Uma outra solução é:
    //Criar o Objeto JSON à partir de JSONSerialize
    //jPerform:=JSONSerialize("{}")
    //Renderizar normalmente
    //jPerform:FromJSON(cPerform)
    //O problema ocorre apenas 1 vez.
    //Após usar esta solução (jPerform:=JSONSerialize("{}")) e até que se reinicie o appserver o problema não mais ocorre.
    oPerform:=JSONArray():New()
    oPerform:FromJSON(cPerform)

    jPerform:=JSONObject():New()
    aPerform:=oPerform:GetNames()
    for i:=1 to Len(aPerform)
        cFileReader:=aPerform[i]
        jPerform[cFileReader]:=JSONObject():New()
        aProperties:=oPerform[#cFileReader]:GetNames()
        for j:=1 to Len(aProperties)
            cProperty:=aProperties[j]
            jPerform[cFileReader][cProperty]:=oPerform[#cFileReader][#cProperty]
        next j
    next i

    //Bye Bye JSONArray. Obrigado pelo Suporte!
    FreeObj(@oPerform)

    for nFile:=1 to Len(aFiles)
        cLine:=""
        cFile:=aFiles[nFile]
        ConOut("FileName["+cFile+"]")
        for i:=1 to Len(aPerform)
            cFileReader:=aPerform[i]
            jPerform[cFileReader]["Reader"]:=cFileReader
            jPerform[cFileReader]["nLines"]:=0
            jPerform[cFileReader]["StrTokArrTotal"]:=0
            jPerform[cFileReader]["StrTokArr2Total"]:=0
            jPerform[cFileReader]["__StrTokArrayTotal"]:=0
            jPerform[cFileReader]["StrTokArrTime"]:=0
            jPerform[cFileReader]["StrTokArr2Time"]:=0
            jPerform[cFileReader]["__StrTokArrayTime"]:=0
            jPerform[cFileReader]["StrHash"]:=0
            if (lStrHashLog)
                jPerform[cFileReader]["StrHashLog"]:=.T.
                jPerform[cFileReader]["StrHashLogger"]:=FileLogger():New(cFile+"."+cFileReader+"."+UUIDRandomSeq()+".log")
            endif
            jPerform[cFileReader]["StrHashTime"]:=0
            jPerform[cFileReader]["nFileSize"]:=0
            if ((cFileReader=="FT").and.(jPerform[cFileReader]["Call"]))
                jPerform[cFileReader]["ProcStart"]:=TimeCounter()
                nHandle:=ft_fUse(cFile)
                //FT_ nao fornece uma funcao para obter o tamanho do arquivo
                //Vamos pegar emprestado de FileNavigator
                oFileNavigator:=FileNavigator():New(;
                    nHandle;
                   ,nil;
                   ,{||.F.};
                   ,{||""};
                )
                jPerform[cFileReader]["nFileSize"]:=oFileNavigator:FileSize()
                FreeObj(@oFileNavigator)
                ft_fGoTop()
                nRecNos:=ft_fLastRec()
                while (!ft_fEof())
                    jPerform[cFileReader]["nLines"]++
                    *****************************************************************
                    //Teste de Navegacao
                    *****************************************************************
                    nRecNo:=ft_fRecNo()
                    ft_fSkip(Randomize(1,nRecNos))
                    ft_fGoto(nRecNo)
                    *****************************************************************
                    cLine:=ft_fReadLn()
                    *****************************************************************
                    __StrHash(@cLine,@cFileReader,@jPerform)
                    *****************************************************************
                    __TSTStrTokArray(@cFileReader,@cLine,@jPerform)
                    *****************************************************************
                    ft_fSkip()
                end while
                ft_fUse()
                jPerform[cFileReader]["ProcEnd"]:=TimeCounter()
                __ConOut(cFileReader,jPerform)
            elseif ((cFileReader=="FWFILEREADER").and.(jPerform[cFileReader]["Call"]))
                jPerform[cFileReader]["ProcStart"]:=TimeCounter()
                oFileReader:=FWFileReader():New(cFile)
                oFileReader:Open()
                jPerform[cFileReader]["nFileSize"]:=oFileReader:GetFileSize()
                oFileNavigator:=FileNavigator():New(;
                    oFileReader:nHandLen;
                   ,{|nHandLen|fSeek(nHandLen,0)};
                   ,{||!oFileReader:HasLine()};
                   ,{||oFileReader:GetLine()};
                )
                nRecNos:=oFileNavigator:BuildIndex()
                //Utilizo, agora, FileNavigator para Navegar pelo arquivo
                while (oFileNavigator:MoreToRead())
                    jPerform[cFileReader]["nLines"]++
                    *****************************************************************
                    //Teste de Navegacao
                    //Sem suporte a Navegacao no Arquivo. Vamos usar FileNavigator
                    *****************************************************************
                    nRecNo:=oFileNavigator:RecNo()
                    oFileNavigator:Skip(Randomize(1,nRecNos))
                    oFileNavigator:GoTo(nRecNo)
                    cLine:=oFileNavigator:ReadLine()
                    *****************************************************************
                    __StrHash(@cLine,@cFileReader,@jPerform)
                    *****************************************************************
                    __TSTStrTokArray(@cFileReader,@cLine,@jPerform)
                    *****************************************************************
                end while
                oFileNavigator:Close({||oFileReader:Close()})
                FreeObj(@oFileNavigator)
                FreeObj(@oFileReader)
                jPerform[cFileReader]["ProcEnd"]:=TimeCounter()
                __ConOut(cFileReader,jPerform)
            elseif ((cFileReader=="TFILEREAD").and.(jPerform[cFileReader]["Call"]))
                jPerform[cFileReader]["ProcStart"]:=TimeCounter()
                oFileReader:=TFileRead():New(cFile)
                oFileReader:Open()
                jPerform[cFileReader]["nFileSize"]:=oFileReader:FileSize()
                oFileNavigator:=FileNavigator():New(;
                    oFileReader:Handle();
                   ,{||oFileReader:GoTop()};
                   ,{||!oFileReader:MoreToRead()};
                   ,{||oFileReader:ReadLine()};
                )
                nRecNos:=oFileNavigator:BuildIndex()
                //Utilizo, agora, FileNavigator para Navegar pelo arquivo
                while (oFileNavigator:MoreToRead())
                    jPerform[cFileReader]["nLines"]++
                    *****************************************************************
                    //Teste de Navegacao
                    //Sem suporte a Navegacao no Arquivo. Vamos usar FileNavigator
                    *****************************************************************
                    nRecNo:=oFileNavigator:RecNo()
                    oFileNavigator:Skip(Randomize(1,nRecNos))
                    oFileNavigator:GoTo(nRecNo)
                    cLine:=oFileNavigator:ReadLine()
                    *****************************************************************
                    __StrHash(@cLine,@cFileReader,@jPerform)
                    *****************************************************************
                    __TSTStrTokArray(@cFileReader,@cLine,@jPerform)
                    *****************************************************************
                end while
                oFileNavigator:Close({||oFileReader:Close()})
                FreeObj(@oFileNavigator)
                FreeObj(@oFileReader)
                jPerform[cFileReader]["ProcEnd"]:=TimeCounter()
                __ConOut(cFileReader,jPerform)
            elseif ((cFileReader=="FILEREADER_HASHMAP").and.(jPerform[cFileReader]["Call"]))
                jPerform[cFileReader]["ProcStart"]:=TimeCounter()
                oFileReader:=fileTools():FileReader(jPerform[cFileReader]["RDD"])
                oFileReader:ft_fUse(cFile)
                jPerform[cFileReader]["nFileSize"]:=oFileReader:ft_fFileSize()
                nRecNos:=oFileReader:ft_fLastRec()
                while (!oFileReader:ft_fEof())
                    jPerform[cFileReader]["nLines"]++
                    *****************************************************************
                    //Teste de Navegacao
                    *****************************************************************
                    nRecNo:=oFileReader:ft_fRecNo()
                    oFileReader:ft_fSkip(Randomize(1,nRecNos))
                    oFileReader:ft_fGoto(nRecNo)
                    *****************************************************************
                    cLine:=oFileReader:ft_fReadLN()
                    *****************************************************************
                    __StrHash(@cLine,@cFileReader,@jPerform)
                    *****************************************************************
                    __TSTStrTokArray(@cFileReader,@cLine,@jPerform)
                    *****************************************************************
                    oFileReader:ft_fSkip()
                end while
                oFileReader:ft_fUse()
                FreeObj(@oFileReader)
                jPerform[cFileReader]["ProcEnd"]:=TimeCounter()
                __ConOut(cFileReader,jPerform)
            elseif ((cFileReader=="FILEREADER_FILE").and.(jPerform[cFileReader]["Call"]))
                jPerform[cFileReader]["ProcStart"]:=TimeCounter()
                oFileReader:=fileTools():FileReader(jPerform[cFileReader]["RDD"])
                oFileReader:ft_fUse(cFile)
                jPerform[cFileReader]["nFileSize"]:=oFileReader:ft_fFileSize()
                nRecNos:=oFileReader:ft_fLastRec()
                while (!oFileReader:ft_fEof())
                    jPerform[cFileReader]["nLines"]++
                    *****************************************************************
                    //Teste de Navegacao
                    *****************************************************************
                    nRecNo:=oFileReader:ft_fRecNo()
                    oFileReader:ft_fSkip(Randomize(1,nRecNos))
                    oFileReader:ft_fGoto(nRecNo)
                    *****************************************************************
                    cLine:=oFileReader:ft_fReadLN()
                    *****************************************************************
                    __StrHash(@cLine,@cFileReader,@jPerform)
                    *****************************************************************
                    __TSTStrTokArray(@cFileReader,@cLine,@jPerform)
                    *****************************************************************
                    oFileReader:ft_fSkip()
                end while
                oFileReader:ft_fUse()
                FreeObj(@oFileReader)
                jPerform[cFileReader]["ProcEnd"]:=TimeCounter()
                __ConOut(cFileReader,jPerform)
            elseif ((cFileReader=="FILEREADER_SQLITE_MEM").and.(jPerform[cFileReader]["Call"]))
                jPerform[cFileReader]["ProcStart"]:=TimeCounter()
                oFileReader:=fileTools():FileReader(jPerform[cFileReader]["RDD"])
                oFileReader:ft_fUse(cFile)
                jPerform[cFileReader]["nFileSize"]:=oFileReader:ft_fFileSize()
                nRecNos:=oFileReader:ft_fLastRec()
                while (!oFileReader:ft_fEof())
                    jPerform[cFileReader]["nLines"]++
                    *****************************************************************
                    //Teste de Navegacao
                    *****************************************************************
                    nRecNo:=oFileReader:ft_fRecNo()
                    oFileReader:ft_fSkip(Randomize(1,nRecNos))
                    oFileReader:ft_fGoto(nRecNo)
                    *****************************************************************
                    cLine:=oFileReader:ft_fReadLN()
                    *****************************************************************
                    __StrHash(@cLine,@cFileReader,@jPerform)
                    *****************************************************************
                    __TSTStrTokArray(@cFileReader,@cLine,@jPerform)
                    *****************************************************************
                    oFileReader:ft_fSkip()
                end while
                oFileReader:ft_fUse()
                FreeObj(@oFileReader)
                jPerform[cFileReader]["ProcEnd"]:=TimeCounter()
                __ConOut(cFileReader,jPerform)
            elseif ((cFileReader=="FILEREADER_SQLITE_TMP").and.(jPerform[cFileReader]["Call"]))
                jPerform[cFileReader]["ProcStart"]:=TimeCounter()
                oFileReader:=fileTools():FileReader(jPerform[cFileReader]["RDD"])
                oFileReader:ft_fUse(cFile)
                jPerform[cFileReader]["nFileSize"]:=oFileReader:ft_fFileSize()
                nRecNos:=oFileReader:ft_fLastRec()
                while (!oFileReader:ft_fEof())
                    jPerform[cFileReader]["nLines"]++
                    *****************************************************************
                    //Teste de Navegacao
                    *****************************************************************
                    nRecNo:=oFileReader:ft_fRecNo()
                    oFileReader:ft_fSkip(Randomize(1,nRecNos))
                    oFileReader:ft_fGoto(nRecNo)
                    *****************************************************************
                    cLine:=oFileReader:ft_fReadLN()
                    *****************************************************************
                    __StrHash(@cLine,@cFileReader,@jPerform)
                    *****************************************************************
                    __TSTStrTokArray(@cFileReader,@cLine,@jPerform)
                    *****************************************************************
                    oFileReader:ft_fSkip()
                end while
                oFileReader:ft_fUse()
                FreeObj(@oFileReader)
                jPerform[cFileReader]["ProcEnd"]:=TimeCounter()
                __ConOut(cFileReader,jPerform)
            elseif ((cFileReader=="FILEREADER_TOPCONN").and.(jPerform[cFileReader]["Call"]))
                jPerform[cFileReader]["ProcStart"]:=TimeCounter()
                oFileReader:=fileTools():FileReader(jPerform[cFileReader]["RDD"])
                oFileReader:ft_fUse(cFile)
                jPerform[cFileReader]["nFileSize"]:=oFileReader:ft_fFileSize()
                nRecNos:=oFileReader:ft_fLastRec()
                while (!oFileReader:ft_fEof())
                    jPerform[cFileReader]["nLines"]++
                    *****************************************************************
                    //Teste de Navegacao
                    *****************************************************************
                    nRecNo:=oFileReader:ft_fRecNo()
                    oFileReader:ft_fSkip(Randomize(1,nRecNos))
                    oFileReader:ft_fGoto(nRecNo)
                    *****************************************************************
                    cLine:=oFileReader:ft_fReadLN()
                    *****************************************************************
                    __StrHash(@cLine,@cFileReader,@jPerform)
                    *****************************************************************
                    __TSTStrTokArray(@cFileReader,@cLine,@jPerform)
                    *****************************************************************
                    oFileReader:ft_fSkip()
                end while
                oFileReader:ft_fUse()
                FreeObj(@oFileReader)
                jPerform[cFileReader]["ProcEnd"]:=TimeCounter()
                __ConOut(cFileReader,jPerform)
            endif
            if ((jPerform[cFileReader]:HasProperty("StrHashLog")).and.(jPerform[cFileReader]["StrHashLog"]))
                jPerform[cFileReader]["StrHashLogger"]:Close()
                FreeObj(@jPerform[cFileReader]["StrHashLogger"])
            endif
        next i
        ConOut(Replicate("*",500))
    next nFile

    for i:=1 to Len(aPerform)
        cFileReader:=aPerform[i]
        ConOut(cFileReader+" => ElapTimeReaderTotal["+LTrim(Str(jPerform[cFileReader]["ReaderTotalTime"]))+"]")
    next i

    FWFreeArray(@aFiles)
    FWFreeArray(@aPerform)

    FreeObj(@jPerform)

return

static procedure __TSTStrTokArray(cFileReader as character,cLine as character,jPerform as json)

    local aLine as array

    local nStrTokTime as numeric

    *****************************************************************
    nStrTokTime:=TimeCounter()
        aLine:=StrTokArr(cLine,";")
    jPerform[cFileReader]["StrTokArrTime"]+=(TimeCounter()-nStrTokTime)
    jPerform[cFileReader]["StrTokArrTotal"]+=Len(aLine)
    *****************************************************************
    FWFreeArray(@aLine)
    *****************************************************************
    nStrTokTime:=TimeCounter()
        aLine:=StrTokArr2(cLine,";")
    jPerform[cFileReader]["StrTokArr2Time"]+=(TimeCounter()-nStrTokTime)
    jPerform[cFileReader]["StrTokArr2Total"]+=Len(aLine)
    *****************************************************************
    FWFreeArray(@aLine)
    *****************************************************************
    nStrTokTime:=TimeCounter()
        aLine:=cTools():__StrTokArray(cLine,";")
    jPerform[cFileReader]["__StrTokArrayTime"]+=(TimeCounter()-nStrTokTime)
    jPerform[cFileReader]["__StrTokArrayTotal"]+=Len(aLine)
    *****************************************************************
    FWFreeArray(@aLine)
    *****************************************************************

return

static procedure __StrHash(cStr,cFileReader,jPerform)
    local nStrHash as numeric
    local nStrHashTime:=TimeCounter() as numeric
    //FWFILEREADER tem Bug e retorna __cCRH10 ou __cCRH13 indevidamente e não bate o Hash da Linha
    if (cFileReader=="FWFILEREADER")
        if (__cCRH10$cStr)
            cStr:=StrTran(cStr,__cCRH10,"")
        endif
        if (__cCRH13$cStr)
            cStr:=StrTran(cStr,__cCRH13,"")
        endif
    endif
    nStrHash:=cTools():StrHash(DecodeUTF8(cStr))
    jPerform[cFileReader]["StrHash"]+=nStrHash
    if ((jPerform[cFileReader]:HasProperty("StrHashLog")).and.(jPerform[cFileReader]["StrHashLog"]))
        jPerform[cFileReader]["StrHashLogger"]:WriteLine(StrZero(nStrHash,16)+" "+cStr)
    endif
    jPerform[cFileReader]["StrHashTime"]+=(TimeCounter()-nStrHashTime)
return

static procedure __ConOut(cFileReader as character,jPerform as json)

    jPerform[cFileReader]["ProcTime"]:=(jPerform[cFileReader]["ProcEnd"]-jPerform[cFileReader]["ProcStart"])

    jPerform[cFileReader]["ReaderTime"]:=(;
        jPerform[cFileReader]["ProcTime"]-(;
            jPerform[cFileReader]["StrTokArrTime"];
           +jPerform[cFileReader]["StrTokArr2Time"];
           +jPerform[cFileReader]["__StrTokArrayTime"];
           +jPerform[cFileReader]["StrHashTime"];
        );
    )

    jPerform[cFileReader]["ReaderTotalTime"]+=jPerform[cFileReader]["ReaderTime"]

    ConOut(jPerform[cFileReader]:ToJSON())

return
