                    *****************************************************************
                    ft_fSkip()
                end while
                ft_fUse()
                nElapTimeTotal:=(TimeCounter()-nTimeCounter)
                nElapTimeReader:=(nElapTimeTotal-(nStrTokElapTime1+nStrTokElapTime2+nStrTokElapTime3))
                ConOut(aPerform[i]+" => ElapTimeReader["+LTrim(Str(nElapTimeReader))+"] => Lines["+LTrim(Str(nLines))+"] => ElapTimeTotal["+LTrim(Str(nElapTimeTotal))+"] => Cols1[("+LTrim(Str(nCols1))+")|("+LTrim(Str(nStrTokElapTime1))+")] => Cols2[("+LTrim(Str(nCols2))+")|("+LTrim(Str(nStrTokElapTime2))+")] => Cols3[("+LTrim(Str(nCols3))+")|("+LTrim(Str(nStrTokElapTime3))+")]")
            elseif aPerform[i]=="FWFileReader"
